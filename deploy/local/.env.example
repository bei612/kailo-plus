# 本地开发拓扑的必填变量。compose.yaml 对每一项都用 ${VAR:?} 强制，
# 缺任一项即拒绝启动——这是「杜绝硬编码」的执行点，不是提示。
# 复制为 deploy/local/.env 后填写；.env 不进版本库。
CORE_DB_NAME=
CORE_DB_USER=
CORE_DB_PORT=
# 部署显示名只填一次（DD-111）：Web 的 HTML、PWA 与标题，以及 BFF 的公开平台信息都从这里投影；
# 缺失、为空或只含空白时 bootstrap 预检与 Core 都拒绝启动。
PLATFORM_DISPLAY_NAME=
# 本地公开入口的可达域名或 IP 与网关端口；同一主值投影到 Compose 别名和浏览器 origin。
PUBLIC_HOST=
# Web 与 IdP 共用的宿主发布地址；填写全部网卡或特定网卡的 IP。内部服务不使用此值。
PUBLIC_BIND_ADDR=
AGENTGATEWAY_PORT=
PUBLIC_ORIGIN=http://${PUBLIC_HOST}:${AGENTGATEWAY_PORT}
TEMPORAL_DB_NAME=
TEMPORAL_DB_USER=
TEMPORAL_FRONTEND_PORT=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_PORT=
TEMPORAL_NAMESPACE=
TEMPORAL_RETENTION=
OIDC_REALM=
OIDC_SERVICE_CLIENT_ID=
OIDC_HOST=
# 本地 Keycloak issuer 由主机名、端口和 realm 派生，不单独维护 URL。
OIDC_ISSUER=http://${OIDC_HOST}:${KEYCLOAK_PORT}/realms/${OIDC_REALM}
OIDC_BROWSER_CLIENT_ID=
BFF_BIND_ADDR=
BFF_CONTAINER_PORT=
BFF_PORT=
BFF_SERVICE_NAME=
WEB_SERVICE_NAME=
WEB_CONTAINER_PORT=
VERIFY_USER=
BOOTSTRAP_USER=
# Platform Catalog Tenant 的首位 admin（DD-96 的 Tenant 暂停/恢复发起者）。
# 与 VERIFY_USER、BOOTSTRAP_USER 两两不同（IdP 用户名不区分大小写）。
PLATFORM_ADMIN_USER=
VERIFY_TENANT_SLUG=
VERIFY_TENANT_NAME=
VERIFY_BOOTSTRAP_WAIT_SECONDS=
REGISTRY_PORT=
REGISTRY_HOST=
PLATFORM_SESSION_TTL_SECONDS=
BFF_MESSAGE_PAGE_LIMIT=
BFF_STREAM_BUFFER=
BFF_STREAM_AUTH_TIMEOUT_SECONDS=
BFF_RELAY_API_BUDGET=
BFF_RELAY_API_BUDGET_WINDOW_SECONDS=
BFF_RELAY_NIP11_TTL_SECONDS=
BFF_MESSAGE_MAX_CONTENT_BYTES=
BFF_STREAM_READMIT_SECONDS=
BFF_STREAM_RETRY_MILLIS=
BFF_MEDIA_MAX_BYTES=
SPICEDB_PORT=
SPICEDB_DB_NAME=
SPICEDB_DB_USER=
SERVICE_BIND_ADDR=
SERVICE_PORT=
SERVICE_CONTAINER_PORT=
OIDC_WORKER_CLIENT_ID=
OPENBAO_PLATFORM_NAMESPACE=
OPENBAO_TENANT_PARENT_NAMESPACE=
OPENBAO_KV_MOUNT=
OPENBAO_TENANT_CORE_ROLE_NAME=
OPENBAO_TENANT_PROVISIONER_ROLE_NAME=
OPENBAO_TENANT_VERIFY_ROLE_NAME=
OPENBAO_KV_MAX_VERSIONS=
OPENBAO_ADDR=
OPENBAO_HTTP_TIMEOUT_SECONDS=
OPENBAO_PORT=
OPENBAO_SECRET_ID_WRAP_TTL=
OPENBAO_SECRET_ID_TTL=
OPENBAO_TOKEN_PERIOD=
TEMPORAL_ADDRESS=
TEMPORAL_TASK_QUEUE=
SPICEDB_ENDPOINT=
BUZZ_DB_NAME=
BUZZ_DB_USER=
BUZZ_OBJECTS_USER=
BUZZ_S3_BUCKET=
BUZZ_S3_REGION=
BUZZ_MEMBER_EVENT_KINDS=
BUZZ_NIP43_RECONCILE_INTERVAL_SECS=
PLATFORM_CATALOG_TENANT_SLUG=
RELAY_OPERATOR_AUDIENCE=
BUZZ_RELAY_PORT=
BUZZ_RELAY_HOST=
BUZZ_RELAY_HEALTH_PORT=
# 私有删除执行器端口；未填时不监听，Core 不启用删除准入。
# bootstrap 将同一端口分别投递到 Relay listener 与 Core private HTTP URL。
BUZZ_DELETION_PORT=
BUZZ_DELETION_HTTP_TIMEOUT_SECONDS=
BUZZ_COMMUNITY_DOMAIN=
OIDC_NATIVE_CLIENT_ID=
OIDC_NATIVE_AUDIENCE=
OIDC_NATIVE_MOBILE_REDIRECT_URI=
AGENTGATEWAY_NATIVE_PORT=
# AgentGateway 管理面（SS-AGW-ADMIN）：Core service client 令牌必须带的 audience；
# realm 以 audience mapper 签入，网关配置 adminAuthentication 以它校验。
AGENTGATEWAY_ADMIN_AUDIENCE=
# Core 的唯一已认证管理入口，供模型投影与 durable usage 读取共用。
# URL 与 deadline 是部署事实；不可用时不推断用量、不推进 checkpoint。
AGENTGATEWAY_ADMIN_URL=
AGENTGATEWAY_ADMIN_TIMEOUT_SECONDS=
# Core runtime 唯一模型入口；主机与私有 listener 端口各填一次，不发布宿主端口。
# 这是 Gateway 入站地址，不是 provider URL，不投递用户或平台运维 token。
AGENTGATEWAY_MODEL_HOST=
AGENTGATEWAY_MODEL_PORT=
AGENTGATEWAY_MODEL_BASE_URL=http://${AGENTGATEWAY_MODEL_HOST}:${AGENTGATEWAY_MODEL_PORT}/v1
# Gateway 独占 provider 凭据卷的绝对挂载目录；Core 只投递/校验此 native 引用，不挂该卷。
AGENTGATEWAY_PROVIDER_SECRET_DIRECTORY=
# AgentGateway request log / durable usage outbox 库（SS-AGW-USAGE），只在 agentgateway-data 网络内
AGENTGATEWAY_DB_NAME=
AGENTGATEWAY_DB_USER=
# OpenMeter 原生 Customer API（DD-37/38、SS-OMT-AUTH）；只有 Core 可经 app 网络调用，
# 原生数据库、消息与去重存储只在 openmeter-data，不发布宿主端口。namespace 只填一次。
OPENMETER_HOST=
OPENMETER_API_PORT=
OPENMETER_CUSTOMERS_URL=http://${OPENMETER_HOST}:${OPENMETER_API_PORT}/api/v3/openmeter/customers
OPENMETER_NAMESPACE=
OPENMETER_HTTP_TIMEOUT_SECONDS=
# 容器内只读 token 文件路径；bootstrap 生成唯一 secrets/openmeter_core_token 后共同挂载。
OPENMETER_CORE_TOKEN_FILE=
# API 与 sink 共用同一原生 YAML；容器内路径必须以 .yaml/.yml 结尾，不覆盖 token 挂载。
OPENMETER_CONFIG_FILE=
OPENMETER_DB_NAME=
OPENMETER_DB_USER=
OPENMETER_CLICKHOUSE_DB_NAME=
OPENMETER_CLICKHOUSE_USER=
OPENMETER_KAFKA_CLUSTER_ID=
# 双侧去重必须启用、使用 Redis；两侧不可共用逻辑库，否则 ingress 的键会使 sink 丢弃事件。
# databases 是 Redis 实际库数量；两索引在其范围内且不同。expiration 使用原生 Go duration，
# 0 表示不自动过期；配置期限不是超出原生崩溃窗口的 exactly-once 承诺。
OPENMETER_REDIS_PORT=
OPENMETER_REDIS_DATABASES=
OPENMETER_INGRESS_DEDUPE_DATABASE=
OPENMETER_SINK_DEDUPE_DATABASE=
OPENMETER_DEDUPE_EXPIRATION=
# Redis noeviction、AOF always 保留去重键；maxmemory 必须为正容量且小于容器预算。
OPENMETER_REDIS_MAXMEMORY=
# sink 的原生健康与 telemetry 只监听本容器回环，不发布业务 API。
OPENMETER_SINK_TELEMETRY_PORT=
# 本机运行预算，不是业务、用户或导出上限；每份 memory 同时投递 mem_limit/memswap_limit。
OPENMETER_API_CPUS=
OPENMETER_API_MEMORY=
OPENMETER_KAFKA_CPUS=
OPENMETER_KAFKA_MEMORY=
OPENMETER_CLICKHOUSE_CPUS=
OPENMETER_CLICKHOUSE_MEMORY=
OPENMETER_POSTGRES_CPUS=
OPENMETER_POSTGRES_MEMORY=
OPENMETER_SINK_CPUS=
OPENMETER_SINK_MEMORY=
OPENMETER_REDIS_CPUS=
OPENMETER_REDIS_MEMORY=
BFF_CLIENT_KEY_PROOF_WINDOW_SECONDS=
BFF_CLIENT_KEYS_PER_PRINCIPAL=
BFF_CLIENT_KEY_RECHECK_MILLIS=
BUZZ_RELAY_NATIVE_URL_TEMPLATE=
WORKER_ACTIVITY_START_TO_CLOSE_SECONDS=
WORKER_ACTIVITY_RETRY_INITIAL_SECONDS=
WORKER_ACTIVITY_RETRY_MAX_SECONDS=
CORE_DB_MAX_CONNECTIONS=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL=
WORKFLOW_RECONCILE_INTERVAL_SECONDS=
WORKFLOW_PROJECTION_FRESHNESS_SECONDS=
WORKFLOW_RECONCILE_BATCH=
WORKER_ACTIVITY_SCHEDULE_TO_CLOSE_SECONDS=
WORKER_ACTIVITY_MAX_ATTEMPTS=
WORKER_CONVERGE_ROUND_INTERVAL_SECONDS=
# AgentTask 原生 Activity holder：心跳间隔小于心跳超时，后者小于 Activity 执行期限。
WORKER_AGENT_ACTIVITY_HEARTBEAT_TIMEOUT_SECONDS=
WORKER_AGENT_ACTIVITY_HEARTBEAT_INTERVAL_SECONDS=
# Core 平台槽位；只接受 ActionDefinition 的同一 pool_key，不提供默认容量。
AGENT_CAPACITY_POOL_KEY=
AGENT_CAPACITY_POOL_UNITS=
AGENT_CAPACITY_UNITS_PER_INVOCATION=
AGENT_CAPACITY_LEASE_SECONDS=
# 原生 Engram 完整读取的投递上界；timestamp window 与固定 Relay 版本一致。
AGENT_MEMORY_LIST_LIMIT=
AGENT_MEMORY_MAX_DECOMPRESSED_BYTES=
AGENT_MEMORY_RELAY_TIMESTAMP_WINDOW_SECONDS=
# 完整 Memory 观察请求的墙钟时限，覆盖取钥、NIP-11 与全部 Relay 分页；无缺省回退。
AGENT_MEMORY_READ_TIMEOUT_SECONDS=
# SERVER_CODEX 的现有五项投递必须整组填写；全空时不向 Core 投递，Agent 运行保持关闭。
# BINARY 取实际 Core runtime 镜像路径（当前原配方 /usr/local/bin/codex-app-server）。
# STATE_ROOT 是已建立、镜像 UID 10001 可写的独立绝对目录；PROFILES_FILE 是运维
# 已提供、该 UID 可读的真实 RuntimeProfileDirectory 文件，原样只读挂载，不生成默认 profile。
AGENT_RUNTIME_BINARY=
AGENT_RUNTIME_STATE_ROOT=
AGENT_RUNTIME_RPC_TIMEOUT_SECONDS=
AGENT_RUNTIME_MAX_MESSAGE_BYTES=
AGENT_RUNTIME_PROFILES_FILE=
ROSTER_RECONCILE_INTERVAL_SECONDS=
PUBLISH_RECONCILE_INTERVAL_SECONDS=
PUBLISH_RESULT_SETTLE_SECONDS=
PUBLISH_RECONCILE_BATCH=
PUBLISH_IDEMPOTENCY_RETENTION_SECONDS=
SPICEDB_HTTP_CONTAINER_PORT=
SPICEDB_HTTP_URL=
APPROVAL_CONSUME_WINDOW_SECONDS=
APPROVAL_DISPATCH_MARGIN_SECONDS=
TEMPORAL_UPDATE_WAIT_SECONDS=
ADMISSION_EVALUATION_TIMEOUT_SECONDS=
GOVERNANCE_RECONCILE_INTERVAL_SECONDS=
GOVERNANCE_RECONCILE_BATCH=
SECRET_REF_REHOME_ALERT_AFTER_SECONDS=
BFF_TASK_PAGE_LIMIT=
BFF_ROLE_MEMBER_PAGE_LIMIT=
SPICEDB_READ_PAGE_LIMIT=
ROLE_RECONCILE_INTERVAL_SECONDS=
TENANT_INVITATION_TTL_SECONDS=
RELAY_OPERATOR_COMMIT_WINDOW_SECONDS=
