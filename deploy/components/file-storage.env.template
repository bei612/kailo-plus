# Cells (file-storage) production delivery for file-storage/deploy/start.sh.
# Install as an owner-only (0600) file outside the repo, e.g.
#   /volumes/data/kailo/components/cells/deploy.env
# Values below are the live non-secret facts of the running kailo-cells-native
# stack (read 2026-10-18) so the same Compose project, networks, data
# directories and port 58092 are replaced in place; secrets stay in the
# existing owner-only files under /volumes/data/kailo/components/cells/secrets.
# Only <to-fill> lines need an operator value. Never put a credential here.

# Same project as the running test stack => in-place recreate, same networks.
CELLS_COMPOSE_PROJECT=kailo-cells-native
# <to-fill> file-storage-service digest from the CI build receipt (file-storage/fork/upstream.yaml).
CELLS_IMAGE=127.0.0.1:55000/file-storage-service@sha256:<to-fill:file-storage-service>
# Its dbManualDSN must end with the upstream per-service table template
#   ...?sslmode=disable&prefix={{.Meta.prefix}}&policies={{.Meta.policies}}&singular={{.Meta.singular}}
# (start.sh refuses it otherwise; file-storage/deploy/verify/deployment.md).
CELLS_INSTALL_FILE=/volumes/data/kailo/components/cells/secrets/install.json
CELLS_DB_PASSWORD_FILE=/volumes/data/kailo/components/cells/secrets/db_password
# <to-fill> single-quoted single-line JSON = content of
# /volumes/data/kailo/components/cells/connectors.json (pydio + kailo-oidc
# connectors; kailo-oidc clientSecretFile must be /run/secrets/cells_oidc_client_secret).
# Production first-login accounts (DD-127(9)): the kailo-oidc config declares
# "provisionUsers": true, "provisionProfile": "standard" (start.sh checks it).
CELLS_OAUTH_CONNECTORS='<to-fill:connectors.json>'
CELLS_OIDC_CLIENT_SECRET_FILE=/volumes/data/kailo/components/cells/secrets/oidc_client_secret
CELLS_OAUTH_SECRET_FILE=/volumes/data/kailo/components/cells/secrets/oauth_secret.json
# Datasource keys = root credential of the embedded object service and of every
# datasource it serves. Owner-only (0600) files, one value each (16-64
# alphanumerics / 24-128 printable characters without whitespace or quotes),
# applied by the image entrypoint (cells admin datasource keys) before start
# and verified by start.sh after it; rotating = replacing both files and
# re-running the deployment (file-storage/deploy/verify/deployment.md).
CELLS_DATASOURCE_KEY_FILE=/volumes/data/kailo/components/cells/secrets/datasource_key
CELLS_DATASOURCE_SECRET_FILE=/volumes/data/kailo/components/cells/secrets/datasource_secret
CELLS_DATA_DIR=/volumes/data/kailo/components/cells/data
CELLS_DB_DATA_DIR=/volumes/data/kailo/components/cells/database
# Owner-only (0700) directory of the deploying user, outside the two above:
# database dump and configuration copy of start.sh --migrate-tables.
CELLS_MIGRATION_BACKUP_DIR=/volumes/data/kailo/components/cells/backups
# Must equal the existing networks' subnets or Compose refuses the project.
CELLS_DATA_SUBNET=10.200.2.0/24
CELLS_UI_SUBNET=10.200.3.0/24
CELLS_DB_NAME=cells
CELLS_DB_USER=cells
CELLS_DB_PORT=5432
CELLS_DB_CPUS=2
CELLS_DB_MEMORY=2g
CELLS_CPUS=4
CELLS_MEMORY=8g
CELLS_BIND=:8080
CELLS_EXTERNAL=http://192.168.0.193:58092
CELLS_NO_TLS=1
CELLS_CONTAINER_PORT=8080
CELLS_PUBLIC_PORT=58092
CELLS_PUBLIC_ADDRESS=0.0.0.0
CELLS_HEALTH_URL=http://127.0.0.1:8080/a/frontend/bootconf
CELLS_HEALTH_INTERVAL=10s
CELLS_HEALTH_TIMEOUT=5s
CELLS_HEALTH_RETRIES=30
CELLS_HEALTH_START_PERIOD=60s
CELLS_START_TIMEOUT_SECONDS=600
# 07 §4.6: exact Web host origin, never '*'.
KAILO_FRAME_ANCESTORS=http://192.168.0.193:58090
TMPDIR=/volumes/data/kailo/tmp

# ---- Declarative native configuration (file-storage/deploy/reconcile.py) ----
# Applied and read back by start.sh after Cells is healthy (and by
# start.sh --reconcile). Draft Mode for governed writes: boolean namespace +
# meta.user USERMETA_DRAFT_API/USERMETA_DRAFT_NAMESPACE.
CELLS_DRAFT_NAMESPACE=usermeta-kailo-draft
# Binding datasource: a dedicated LOCAL flat datasource (created beside the
# existing ones by the image entrypoint before start, `cells admin datasource
# ensure`, when missing) that no other workspace roots; pydiods1 is refused while
# the stock common-files workspace roots it. Versioning policy id of this
# instance (keep-all: fixed revisions referenced by the platform never expire).
CELLS_BINDING_DATASOURCE=kailobinding
CELLS_BINDING_VERSIONING_POLICY=keep-all
# Binding workspace rooted on the real folder <datasource>/<folder>.
CELLS_BINDING_ROOT_FOLDER=kailo-binding
CELLS_BINDING_WORKSPACE_SLUG=kailo-binding
CELLS_BINDING_WORKSPACE_LABEL='Kailo binding'
# <to-fill> exactly the native users granted on the binding root: the service
# user behind cells_bearer (read) and every native user linked to a Kailo actor
# (read+write), as "<login>:r|rw" separated by spaces. Existing users only.
CELLS_BINDING_PRINCIPALS='<to-fill:service-login:r actor-login:rw>'
# <to-fill> the service login above (its UUID becomes instanceServiceUuid).
CELLS_BINDING_SERVICE_LOGIN=<to-fill:service-login>
# Owner-only output (directory 0700): nativeScopeRef/nativeRootRef and principal
# UUIDs for the binding plan and the native action delivery.
CELLS_BINDING_FACTS_FILE=/volumes/data/kailo/components/cells/binding/facts.json

# ---- Native ONLYOFFICE editing (DD-132, file-storage/deploy/reconcile.py) ----
# DocumentServer public origin = document-editor DOCUMENT_EDITOR_PUBLIC_ORIGIN;
# deploy document-editor first: reconcile reads its discovery back before it
# enables editor.onlyoffice (wopisrc base = CELLS_EXTERNAL, which must equal
# document-editor DOCUMENT_EDITOR_WOPI_SOURCE_ORIGIN). Leave both empty to keep
# the plugin disabled. editor.libreoffice (Collabora) is kept disabled.
CELLS_ONLYOFFICE_PUBLIC_ORIGIN=http://192.168.0.193:58096
CELLS_ONLYOFFICE_EXTENSIONS=docx,xlsx,pptx,odt,ods,odp,doc,xls,ppt,rtf,txt,csv,pdf

# ---- Adapter (start.sh --platform-adapter), after the binding plan exists ----
# <to-fill> file-storage-adapter digest; must equal the release adapterBuildRef.
CELLS_ADAPTER_IMAGE=127.0.0.1:55000/file-storage-adapter@sha256:<to-fill:file-storage-adapter>
CELLS_ADAPTER_UID=1000
CELLS_ADAPTER_GID=1000
CELLS_ADAPTER_CPUS=0.5
CELLS_ADAPTER_MEMORY=256m
# Owner-only (0700) directory: adapter config, Agent-rendered secrets, ActionToken
# JWKS copy and the Agent socket. Separate from data/database/bootstrap.
CELLS_ADAPTER_DELIVERY_DIR=/volumes/data/kailo/components/cells/adapter-delivery
CELLS_ADAPTER_CONFIG_FILE=/volumes/data/kailo/components/cells/adapter-delivery/adapter.json
# Core and OpenBao network (adapter-directory baseUrl http://file-storage-adapter:8080/).
CELLS_ADAPTER_PLATFORM_NETWORK=platform-local_app
# Required once the adapter maps write/delete/share (all seven FILE_STORAGE@2
# actions are mandatory): owner-only 0700 directory rendered by
# adapter-delivery.py config --kind cells-native (file-storage-native-action.template.json)
# plus the binding oidc_client_secret rendered there by the same Agent
# (reader --extra-delivery-dir/--extra-secret, ADAPTER_AGENT_EXTRA_DIR below).
# The meter and native `share` gates are closed (DD-124(6): every action
# meters [] and quotaPolicy NONE, capability meter UNSUPPORTED, all adapter and
# native usageMeasurements []; start.sh validates `share`); enable these two
# lines together with the binding plan and ADAPTER_AGENT_EXTRA_DIR below.
# CELLS_NATIVE_ACTION_DELIVERY_DIR=/volumes/data/kailo/components/cells/native-action
# CELLS_NATIVE_ACTION_CONFIG_FILE=/volumes/data/kailo/components/cells/native-action/native.json

# ---- Agent project (deploy/components/compose.adapter-agent.yaml) ----
ADAPTER_AGENT_PROJECT=kailo-cells-adapter-agent
ADAPTER_AGENT_IMAGE=openbao/openbao@sha256:7d26314820a535ef346f1e63911809e4d356b48068fef00a9dcb3400bb9e11b6
ADAPTER_AGENT_UID=1000
ADAPTER_AGENT_GID=1000
ADAPTER_AGENT_BOOTSTRAP_DIR=/volumes/data/kailo/components/cells/adapter-bootstrap
ADAPTER_AGENT_DELIVERY_DIR=/volumes/data/kailo/components/cells/adapter-delivery
ADAPTER_AGENT_PLATFORM_NETWORK=platform-local_app
# Same directory as CELLS_NATIVE_ACTION_DELIVERY_DIR (compose.adapter-agent.native.yaml).
# ADAPTER_AGENT_EXTRA_DIR=/volumes/data/kailo/components/cells/native-action
