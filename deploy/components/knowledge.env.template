# WeKnora (knowledge) production native env for knowledge/fork/deploy/start.sh
# --native-env <this> --platform-model /volumes/kailo/apps/deploy/local/.env.
# Install owner-only (0600) outside the repo, e.g.
#   /volumes/data/kailo/components/knowledge/native.env
# The Compose project name is fixed (kailo-knowledge) in compose.yaml, so the
# running test stack's containers are replaced in place and its named volumes
# kailo-knowledge_native_{postgres,files,redis} are reused. Secret files are
# the existing OpenBao-rendered files of the running stack. Values were read
# from the running containers on 2026-10-18; only <to-fill> needs input.

# <to-fill> digests from the CI build receipts (knowledge/fork/upstream.yaml).
KNOWLEDGE_APP_REPOSITORY=127.0.0.1:55000/knowledge-service
KNOWLEDGE_APP_DIGEST=<to-fill:knowledge-service, 64 hex without sha256:>
KNOWLEDGE_UI_REPOSITORY=127.0.0.1:55000/knowledge-native-ui
KNOWLEDGE_UI_DIGEST=<to-fill:knowledge-native-ui>
KNOWLEDGE_DOCREADER_REPOSITORY=127.0.0.1:55000/knowledge-document-reader
KNOWLEDGE_DOCREADER_DIGEST=<to-fill:knowledge-document-reader>
# DD-164(10), .design/07 §4.6 entry topology: the browser origin is served by the Kailo gateway's
# component listener (platform .env KAILO_EDGE_COMPONENTS, deploy/local/edge-overlay.py); this
# container port is published on loopback only, on a port other than the origin port, and the
# container joins the platform edge network (= platform .env PLATFORM_EDGE_NETWORK) under a fixed alias.
KNOWLEDGE_UI_BIND_ADDRESS=127.0.0.1
KNOWLEDGE_UI_PORT=58114
KNOWLEDGE_EDGE_NETWORK=platform-local_edge
# Must equal the existing kailo-knowledge_native_{ui,data} subnets.
KNOWLEDGE_UI_SUBNET=10.200.0.0/24
KNOWLEDGE_DATA_SUBNET=10.200.1.0/24
KNOWLEDGE_DB_USER=weknora
KNOWLEDGE_DB_NAME=weknora
KNOWLEDGE_NATIVE_ORIGIN=http://192.168.0.193:58094
KNOWLEDGE_OIDC_ISSUER_URL=http://192.168.0.193:8080/realms/kailo
KNOWLEDGE_OIDC_DISCOVERY_URL=http://192.168.0.193:8080/realms/kailo/.well-known/openid-configuration
KNOWLEDGE_OIDC_CLIENT_ID=kailo-knowledge-native
# <to-fill> copy the existing value (private IdP host allowed by native SSRF guard).
KNOWLEDGE_SSRF_WHITELIST_EXTRA=<to-fill:existing value>
# 07 §4.6: exact Web host origin (frontend emits frame-ancestors from it).
KAILO_FRAME_ANCESTORS=http://192.168.0.193:58090
# ---- Kailo DD-133: one product, one sign-in ----
# Product name shown by the native UI: "<PLATFORM_DISPLAY_NAME> 知识库" / "… Knowledge".
# <to-fill> the same value as PLATFORM_DISPLAY_NAME in the platform .env.
PLATFORM_DISPLAY_NAME=<to-fill:platform display name>
# Optional Kailo page that ends the Kailo session (top-level "退出"); empty
# returns to <first KAILO_FRAME_ANCESTORS origin>/app/, where the user signs out.
KAILO_LOGOUT_URL=
# 07 §4.7.4: the Kailo Tenant of the knowledge binding this instance serves
# (DEDICATED_INSTANCE). Every Kailo login joins its native space as a member.
KAILO_TENANT_ID=<to-fill:Kailo tenant id of the binding>
KAILO_TENANT_NAME=<to-fill:Kailo tenant display name>
# 07 §4.7.5: a native session never outlives the IdP SSO session maximum.
KAILO_SESSION_MAX_LIFETIME=10h
# ---- DD-133(4): member directory read (07 §4.7.4) ----
# Empty BINDING_ID = directory not delivered (every login a contributor, no
# native administrator). The five keys are named together; start.sh then
# overlays compose.member-directory.yaml and app joins
# KNOWLEDGE_ADAPTER_PLATFORM_NETWORK (below) to reach Core's service listener.
# <to-fill> the knowledge native page entry binding id; register it with
# component-bind.mjs --directory-client-id kailo-knowledge-directory.
KNOWLEDGE_DIRECTORY_BINDING_ID=<to-fill:knowledge native page entry binding id>
# Same value as the knowledge entry of COMPONENT_DIRECTORY_CLIENTS in the platform .env.
KNOWLEDGE_DIRECTORY_CLIENT_ID=kailo-knowledge-directory
# Written by the platform release (bootstrap.sh --declare-directory-clients), 0600, never printed.
KNOWLEDGE_DIRECTORY_CLIENT_SECRET_FILE=/volumes/kailo/apps/deploy/local/secrets/component-directory/knowledge/client_secret
KNOWLEDGE_DIRECTORY_TOKEN_URL=http://192.168.0.193:8080/realms/kailo/protocol/openid-connect/token
# <to-fill> http://<BFF_SERVICE_NAME>:<SERVICE_CONTAINER_PORT> of the platform .env.
KNOWLEDGE_DIRECTORY_CORE_URL=<to-fill:Core service listener origin>
KNOWLEDGE_DIRECTORY_INTERVAL_SECONDS=60
KNOWLEDGE_DB_PASSWORD_FILE=/volumes/kailo/apps/deploy/local/secrets/knowledge-native/db_password
KNOWLEDGE_REDIS_PASSWORD_FILE=/volumes/kailo/apps/deploy/local/secrets/knowledge-native/redis_password
KNOWLEDGE_REDIS_CONFIG_FILE=/volumes/kailo/apps/deploy/local/secrets/knowledge-native/redis_config
KNOWLEDGE_SYSTEM_AES_KEY_FILE=/volumes/kailo/apps/deploy/local/secrets/knowledge-native/system_aes_key
KNOWLEDGE_SYSTEM_SIGNING_KEY_FILE=/volumes/kailo/apps/deploy/local/secrets/knowledge-native/system_signing_key
KNOWLEDGE_JWT_SECRET_FILE=/volumes/kailo/apps/deploy/local/secrets/knowledge-native/jwt_secret
KNOWLEDGE_OIDC_CLIENT_SECRET_FILE=/volumes/kailo/apps/deploy/local/secrets/knowledge-native/oidc_client_secret

# ---- Platform model key (DD-128(5): native page entry binding with PLATFORM_LLM_ROUTE) ----
# Empty = no platform model key: the native page and login work, model calls are refused.
# KNOWLEDGE_BUILTIN_MODELS_FILE is rendered by component-deploy.sh (native-config.py) from
# deploy/components/knowledge-builtin-models.template.yaml and the facts below, never by hand;
# its directory must be owner-only. The secret env (empty 0600 file until
# bootstrap.sh --native-model-delivery materialize-weknora <this file> writes the key) and the
# declaration are named together; start.sh then adds compose.native-model.yaml.
KNOWLEDGE_NATIVE_MODEL_DELIVERY_DIR=
KNOWLEDGE_MODEL_SECRET_ENV_FILE=
KNOWLEDGE_BUILTIN_MODELS_FILE=
# Facts: the routes' native model ids (the binding's frozen set), the dimension measured
# from a real embedding response of that route, and a KAILO_MODEL_* key name.
KNOWLEDGE_MODEL_CHAT_ID=
KNOWLEDGE_MODEL_EMBEDDING_ID=
KNOWLEDGE_MODEL_EMBEDDING_DIM=
KNOWLEDGE_MODEL_API_KEY_NAME=

# ---- Adapter (start.sh --platform-adapter), after the binding plan exists ----
KNOWLEDGE_ADAPTER_REPOSITORY=127.0.0.1:55000/knowledge-adapter
# <to-fill> must equal the release adapterBuildRef.
KNOWLEDGE_ADAPTER_DIGEST=<to-fill:knowledge-adapter>
KNOWLEDGE_ADAPTER_UID=1000
KNOWLEDGE_ADAPTER_GID=1000
KNOWLEDGE_ADAPTER_CPUS=0.5
KNOWLEDGE_ADAPTER_MEMORY=256m
KNOWLEDGE_ADAPTER_DELIVERY_DIRECTORY=/volumes/data/kailo/components/knowledge/adapter-delivery
KNOWLEDGE_ADAPTER_BOOTSTRAP_DIRECTORY=/volumes/data/kailo/components/knowledge/adapter-bootstrap
KNOWLEDGE_ADAPTER_CONFIG_FILE=/volumes/data/kailo/components/knowledge/adapter-config/adapter.json
# Public-only ActionToken JWKS rendered by start-core.sh --prepare-action-token (its jwksFile).
KNOWLEDGE_ADAPTER_JWKS_FILE=<to-fill:jwksFile of ACTION_TOKEN_SIGNING_FILE>
KNOWLEDGE_ADAPTER_AGENT_REPOSITORY=openbao/openbao
KNOWLEDGE_ADAPTER_AGENT_DIGEST=7d26314820a535ef346f1e63911809e4d356b48068fef00a9dcb3400bb9e11b6
KNOWLEDGE_ADAPTER_AGENT_CPUS=0.25
KNOWLEDGE_ADAPTER_AGENT_MEMORY=128m
# Core and OpenBao network (adapter-directory baseUrl http://knowledge-adapter:8080/).
KNOWLEDGE_ADAPTER_PLATFORM_NETWORK=platform-local_app
