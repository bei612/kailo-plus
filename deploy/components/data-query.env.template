# Wren GenBI (data-query) native component env (DD-127(7)); same shape as
# knowledge.env.template. It is the sole Wren deployment input of
# data-query/docker/docker-compose.yaml and deploy/components/component-deploy.sh
# data-query. Install owner-only (0600) in the owner-only (0700) component
# directory, e.g. /volumes/data/kailo/components/data-query/native.env.
# Values are literal (no ${...}); no credential value belongs here, only paths
# of component-only owner-only files. The platform deploy/local/.env supplies
# only OIDC_ISSUER and PLATFORM_EDGE_NETWORK (component-deploy.sh passes them;
# for a manual Compose call export the same two keys first).

# Independent Compose project; never platform-local.
WREN_COMPOSE_PROJECT_NAME=platform-local-wren-native
WREN_PLATFORM=linux/amd64
# <to-fill> digests: artifact_digest of data-query/fork/upstream.yaml for
# UI/AI/Engine/Ibis; WREN_GATEWAY_IMAGE is the source-built model-gateway digest.
WREN_UI_IMAGE=127.0.0.1:55000/data-query-ui@sha256:<to-fill:data-query-ui>
WREN_AI_IMAGE=127.0.0.1:55000/data-query-ai-service@sha256:<to-fill:data-query-ai-service>
WREN_ENGINE_IMAGE=127.0.0.1:55000/data-query-engine@sha256:<to-fill:data-query-engine>
WREN_IBIS_IMAGE=127.0.0.1:55000/data-query-ibis@sha256:<to-fill:data-query-ibis>
WREN_GATEWAY_IMAGE=127.0.0.1:55000/model-gateway@sha256:<to-fill:model-gateway>
# Unchanged dependencies of the fixed GenBI c5f02a0 recipe (registry-read digests).
WREN_BOOTSTRAP_IMAGE=ghcr.io/canner/wren-bootstrap:0.1.5@sha256:731c3085cee5c87a79b07d27c9d10eb35f4830b0cac46a51ac8e9f6606698ada
WREN_QDRANT_IMAGE=qdrant/qdrant:v1.11.0@sha256:cc802bd2841ec2026725e19619075982311ce4d7182dc8c03a0c8e6817bb9170
# Internal ports/versions/SQLite path keep the fixed native .env.example values.
WREN_ENGINE_PORT=8080
WREN_ENGINE_SQL_PORT=7432
WREN_AI_SERVICE_PORT=5555
WREN_UI_PORT=3000
WREN_UI_BIND_ADDRESS=0.0.0.0
WREN_IBIS_SERVER_PORT=8000
WREN_GATEWAY_HTTP_PORT=8080
WREN_GATEWAY_ADMIN_PORT=15000
WREN_DB_TYPE=sqlite
WREN_SQLITE_FILE=/app/data/db.sqlite3
WREN_PRODUCT_VERSION=0.29.1-rc.1
WREN_ENGINE_VERSION=0.22.0
WREN_AI_SERVICE_VERSION=0.29.0
WREN_UI_VERSION=0.32.2
WREN_TELEMETRY_ENABLED=false
WREN_EXPERIMENTAL_ENGINE_RUST_VERSION=false
WREN_USER_UUID=
WREN_POSTHOG_API_KEY=
WREN_POSTHOG_HOST=
# Native telemetry label only; the models are those of the native config.yaml.
WREN_GENERATION_MODEL=
# Normal starts never force the native deploy mutation.
WREN_SHOULD_FORCE_DEPLOY=

# Published native page: only the native Gateway, bound to the LAN address.
WREN_PUBLIC_BIND_ADDR=192.168.0.193
WREN_PUBLIC_PORT=58095
WREN_PUBLIC_ORIGIN=http://192.168.0.193:58095
# 07 §4.6: exact Kailo Web origin(s); wren-ui emits frame-ancestors from it.
KAILO_FRAME_ANCESTORS=http://192.168.0.193:58090

# Existing owner-only directories (bind mounts never create them).
# config.yaml holds the native providers (README "Native model configuration").
WREN_PROJECT_DIR=/volumes/data/kailo/components/data-query
WREN_LOCAL_STORAGE=/volumes/data/kailo/components/data-query/data
# Dedicated native clients of the platform IdP (never a platform client).
WREN_OIDC_CLIENT_ID=platform-local-wren-native-browser
# Native verifier JSON: issuer, audience (browser client), serviceAudience (AI
# client), jwksUrl, accessClaim, accessValue, publicOrigin. bootstrap.sh
# --register-wren-native-clients declares accessClaim/accessValue on both clients.
WREN_NATIVE_IDENTITY_JSON=<to-fill:single-line JSON>
# Component-only owner-only files (contents never in this file):
#   OIDC: WREN_OIDC_CLIENT_SECRET + independent OIDC_COOKIE_SECRET (64 hex)
WREN_OIDC_SECRET_ENV_FILE=/volumes/data/kailo/components/data-query/browser-oidc.env
#   AI: native model env named by config.yaml api_key_name; may be empty
WREN_AI_SECRET_ENV_FILE=/volumes/data/kailo/components/data-query/ai.env
#   AI service identity: identity.json + native AI client secret
WREN_AI_IDENTITY_DIR=/volumes/data/kailo/components/data-query/native-identity
#   UI: PG_URL only with WREN_DB_TYPE=pg; empty for SQLite
WREN_UI_SECRET_ENV_FILE=/volumes/data/kailo/components/data-query/ui-database
#   encryption-password / encryption-salt (keep with the native DB backups)
WREN_NATIVE_DATA_KEY_DIR=/volumes/data/kailo/components/data-query/data-keys

# ---- Agent tool path only (capability release + binding), all optional ----
# Verified model credential delivery overlay (data-query/docker/model-delivery.yaml):
# set only when the frozen model projection exists; empty keeps it off.
WREN_MODEL_DELIVERY_DIR=
# Governed query delivery (component-deploy.sh data-query <commit> --adapter):
# data-query/docker/query-governance.yaml + one component-specific OpenBao Agent
# (deploy/components/compose.adapter-agent.yaml, its own Compose project). Two
# OpenBao Agent deliveries, each in its own namespace with its own AppRole
# (07 §2.5, DD-70/71/94); no copy and no second channel:
#   platform namespace : ActionToken public JWKS = jwksFile of the platform
#                        ACTION_TOKEN_SIGNING_FILE and the platform
#                        GATEWAY_SERVICE_JWKS_FILE (both read from the platform
#                        .env by component-deploy.sh), mounted read-only.
#   tenants/<tenantId> : the binding's connection + oidc_client_secret SecretRefs
#                        and the api_proxy socket, rendered into WREN_QUERY_DELIVERY_DIR
#                        by the Agent whose HCL/role-id/wrapped secret-id
#                        adapter-delivery.py reader writes into WREN_QUERY_AGENT_BOOTSTRAP_DIR.
# Both directories: owner-only (0700), owned by WREN_QUERY_AGENT_UID, separate.
WREN_QUERY_OPENBAO_IMAGE=openbao/openbao@sha256:7d26314820a535ef346f1e63911809e4d356b48068fef00a9dcb3400bb9e11b6
WREN_QUERY_AGENT_PROJECT=platform-local-wren-query-agent
WREN_QUERY_AGENT_UID=1000
WREN_QUERY_AGENT_GID=1000
WREN_QUERY_AGENT_BOOTSTRAP_DIR=/volumes/data/kailo/components/data-query/query-bootstrap
WREN_QUERY_DELIVERY_DIR=/volumes/data/kailo/components/data-query/query-delivery
# Core/OpenBao network (adapter-directory baseUrl/mcpUrl reach wren-ui here).
WREN_QUERY_PLATFORM_NETWORK=platform-local_app
WREN_QUERY_ACTION_JWKS_FILE=/volumes/data/kailo/components/platform-delivery/action-token-public/jwks.json
#
# Order (data-query/docker/README.md "Governed query credential delivery"):
#   1 native onboarding of the one PostgreSQL project with a read-only role;
#   2 flow/capability-contract-activate.mjs data_query@2, release registered/approved;
#   3 component-bind.mjs --component data-query --workspace-id <ws>
#     --native-scope-ref <project id> --plan-only;
#   4 adapter-delivery.py config --kind data-query, then reader (Tenant namespace);
#   5 component-deploy.sh data-query <commit> --adapter --check, then without --check;
#   6 component-bind.mjs (same args, --secret-values-file) -> Core writes the two
#     SecretRefs, handshake/validate_binding; adapter-delivery.py client once the
#     Agent rendered oidc_client_secret. Model/view Resources, once ACTIVE, via
#     `resource-evidence` + flow/resource-register.mjs.
