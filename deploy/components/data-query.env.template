# Wren GenBI (data-query) production keys. data-query/docker/README.md makes
# /volumes/kailo/apps/deploy/local/.env the sole env authority for
# data-query/docker/docker-compose.yaml, and the live .env already carries a
# Wren section (WREN_COMPOSE_PROJECT_NAME=platform-local-wren-native,
# WREN_PUBLIC_PORT=58095, WREN_PROJECT_DIR=/volumes/data/kailo/components/wren-native).
# Merge ONLY these keys into that .env (edit in place after a backup copy; do
# not paste credentials). Everything else keeps its current value.

# <to-fill> digests from the CI build receipts (data-query/fork/upstream.yaml).
# data-query-ui must be built from a commit that contains the governed
# connection-secret fix (governedConnectionInfo); it is also the Wren adapterBuildRef.
WREN_UI_IMAGE=${REGISTRY_HOST}/data-query-ui@sha256:<to-fill:data-query-ui>
WREN_AI_IMAGE=${REGISTRY_HOST}/data-query-ai-service@sha256:<to-fill:data-query-ai-service>
WREN_ENGINE_IMAGE=${REGISTRY_HOST}/data-query-engine@sha256:<to-fill:data-query-engine>
# The live value is the unadapted upstream ibis image; replace with the fork artifact.
WREN_IBIS_IMAGE=${REGISTRY_HOST}/data-query-ibis@sha256:<to-fill:data-query-ibis>
# Published native page (gateway OIDC in front of wren-ui).
WREN_PUBLIC_PORT=58095
WREN_PUBLIC_BIND_ADDR=192.168.0.193
WREN_PUBLIC_ORIGIN=http://192.168.0.193:58095
# 07 §4.6: consumed only by data-query/docker/docker-compose.yaml (wren-ui CSP).
KAILO_FRAME_ANCESTORS=http://192.168.0.193:58090
# Normal starts never force native deploy mutation.
WREN_SHOULD_FORCE_DEPLOY=

