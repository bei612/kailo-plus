# document-editor (ONLYOFFICE DocumentServer, DD-132) production delivery for
# document-editor/deploy/start.sh and deploy/components/component-deploy.sh.
# Install as an owner-only (0600) file outside the repo:
#   /volumes/data/kailo/components/document-editor/native.env
# Only <to-fill> lines need an operator value. Never put a credential here:
# the two secrets live in their own owner-only files (not OpenBao, DD-127(7)).

DOCUMENT_EDITOR_COMPOSE_PROJECT=kailo-document-editor
# <to-fill> document-editor digest from the CI build receipt (document-editor/fork/upstream.yaml).
DOCUMENT_EDITOR_IMAGE=127.0.0.1:55000/document-editor@sha256:<to-fill:document-editor>

# Public origin of this instance = its wopi.host; every discovery action uses it.
DOCUMENT_EDITOR_PUBLIC_ORIGIN=http://192.168.0.193:58096
# DD-164(10), .design/07 §4.6 entry topology: the browser origin is served by the Kailo gateway's
# component listener (platform .env KAILO_EDGE_COMPONENTS, deploy/local/edge-overlay.py); this
# container port is published on loopback only, on a port other than the origin port, and the
# container joins the platform edge network (= platform .env PLATFORM_EDGE_NETWORK) under a fixed alias.
DOCUMENT_EDITOR_PUBLIC_ADDRESS=127.0.0.1
DOCUMENT_EDITOR_PUBLIC_PORT=58116
DOCUMENT_EDITOR_EDGE_NETWORK=platform-local_edge
# The Cells origin (file-storage CELLS_EXTERNAL): the only outbound target
# (<origin>/wopi/files/ allow-list, ipfilter on its host) and the wopisrc base
# the Cells plugin uses (ONLYOFFICE_WOPI_SOURCE_ORIGIN).
DOCUMENT_EDITOR_WOPI_SOURCE_ORIGIN=http://192.168.0.193:58092
# 07 §4.6 / DD-132(3): exact origins allowed to frame the editor besides itself:
# Cells and the hosts Cells itself allows (Cells KAILO_FRAME_ANCESTORS).
DOCUMENT_EDITOR_FRAME_ANCESTORS='http://192.168.0.193:58092 http://192.168.0.193:58090'

# Owner-only (0600) files of the deploying user, one value each (32-256
# URL-safe characters), independent of each other and of every other component:
#   umask 077; openssl rand -hex 32 > <file>
DOCUMENT_EDITOR_TOKEN_SECRET_FILE=/volumes/data/kailo/components/document-editor/secrets/token_secret
DOCUMENT_EDITOR_SECURE_LINK_SECRET_FILE=/volumes/data/kailo/components/document-editor/secrets/secure_link_secret
# Rendered by native-config.py from document-editor/deploy/local.template.json
# (0644, no secret) in an owner-only (0700) directory.
DOCUMENT_EDITOR_LOCAL_CONFIG_FILE=/volumes/data/kailo/components/document-editor/config/local.json
# State (App_Data): owned by 101:102 (the image ds user), mode 0750.
DOCUMENT_EDITOR_DATA_DIR=/volumes/data/kailo/components/document-editor/data
DOCUMENT_EDITOR_SUBNET=10.200.10.0/24
DOCUMENT_EDITOR_CPUS=4
DOCUMENT_EDITOR_MEMORY=6g
DOCUMENT_EDITOR_HEALTH_INTERVAL=15s
DOCUMENT_EDITOR_HEALTH_TIMEOUT=5s
DOCUMENT_EDITOR_HEALTH_RETRIES=20
DOCUMENT_EDITOR_HEALTH_START_PERIOD=120s
DOCUMENT_EDITOR_START_TIMEOUT_SECONDS=600
TMPDIR=/volumes/data/kailo/tmp
