# Batch E: platform deployment keys for native pages and component bindings.
# Merge into the sole platform env /volumes/kailo/apps/deploy/local/.env (back
# it up first: cp -p .env .env.bak-$(date -u +%Y%m%dT%H%M%SZ)). Values are
# non-secret references; the files they name are created as described. Apply
# with start-core.sh from the fixed release tree whose compose.yaml pins equal
# the running Core/Worker/Web images (check with platform-config-check.sh).

# 07 §4.6 / application_page.rs: deployment allowlist of native page origins.
# The same value is projected to Core (descriptor check) and to buzz-web's
# Caddy CSP `frame-src 'self' blob: {$WEB_EDITOR_ORIGINS} {$NATIVE_PAGE_ORIGINS}`.
# Exact origins only; never '*' and never PUBLIC_ORIGIN.
NATIVE_PAGE_ORIGINS="http://192.168.0.193:58092 http://192.168.0.193:58094 http://192.168.0.193:58095"

# DD-133(3)(6) / .design/07 §4.7.3, §4.7.5: the three dedicated browser clients get the
# profile/email scopes, kailo-picture/kailo-locale mappers and OIDC back-channel
# logout; the release deploy applies ./bootstrap.sh --declare-native-client-profiles when the
# configuration digest changes and verify reads it back (ADR-20 §8; idempotent).
NATIVE_OIDC_CLIENTS=kailo-cells-native-browser=http://192.168.0.193:58092/auth/kailo/backchannel-logout,kailo-knowledge-native=http://192.168.0.193:58094/api/v1/auth/oidc/backchannel-logout,platform-local-wren-native-browser=http://192.168.0.193:58095/oauth/backchannel-logout

# DD-94: controlled ApplicationAdapterDirectory, rendered by
# tools/component-release/adapter-directory.mjs from the rendered releases.
# Canonical real file, mode 0644 (Core runs as uid 10001), in a 0755 directory.
APPLICATION_ADAPTER_DIRECTORY_FILE=/volumes/data/kailo/components/platform-delivery/adapter-directory.json

# DD-49/70/94: ActionTokenSigningDelivery (contracts/domain/action_token_signing_delivery.schema.json),
# mode 0644, content (no key material):
#   {"issuer":"http://core-bff:8082/action-token","tokenSeconds":300,
#    "secretLocator":"platform/kv/action-token/signing","secretVersion":1,
#    "secretAudience":"kailo-core","privateKeyField":"private_jwk",
#    "jwksFile":"/volumes/data/kailo/components/platform-delivery/action-token-public/jwks.json"}
# issuer must differ from OIDC_ISSUER and GATEWAY_SERVICE_ISSUER; secretAudience
# must equal OIDC_SERVICE_CLIENT_ID; secretLocator uses OPENBAO_PLATFORM_NAMESPACE/OPENBAO_KV_MOUNT.
# The jwksFile directory must exist, be owned by the operator, mode 0700, and
# contain nothing but what --prepare-action-token writes there.
ACTION_TOKEN_SIGNING_FILE=/volumes/data/kailo/components/platform-delivery/action-token/signing.json
# Only for the one-time ./start-core.sh --prepare-action-token (public-only KV
# locator, different from secretLocator, and its read-only AppRole).
ACTION_TOKEN_PUBLIC_JWKS_LOCATOR=platform/kv/action-token/public-jwks
ACTION_TOKEN_JWKS_READER_ROLE=action-token-jwks-reader

# .design/07 §8A, DD-136(2): conformance candidates coexist, one subdirectory per
# artifact digest (environment.json; HTTP adapters also fixture.json,
# identity.json and its jwks.json). Core and Worker pick the candidate of the
# release being registered and read it per use: the release entry writes the
# PROTOCOL_PEER candidate, component-deploy.sh <component> <commit> --conformance
# writes a REMOTE_ADAPTER candidate after an unattended isolated run and
# --conformance-close removes it. Never switch candidates by editing .env.
COMPONENT_CONFORMANCE_DIR=${KAILO_RUNTIME_DIR}/data/conformance
COMPONENT_CONFORMANCE_WORKER_DIR=${KAILO_RUNTIME_DIR}/data/conformance-worker

# DD-70 / 03 §9: Core verifies every binding SecretRef read against the
# OpenBao audit trail (secret-store AuditObserver::verify_secret_reads). It reads
# the second declarative file device core-observed/ (secret-store-config.hcl),
# written to data/secret-store-audit (owner 100, group below, setgid 2750, file
# 0640) and mounted read-only into core-bff with this supplementary group. The
# full file/ device inside the raft directory stays private to OpenBao.
# Prepare the directory with ./secret-store-audit-dir.sh --prepare, then
# recreate openbao (+ unseal via secret-store-init.sh) and start
# openbao-audit-bound before ./start-core.sh. GID must be unused on the host.
OPENBAO_AUDIT_READER_GID=10070
# Core refuses an observation file larger than MAX; openbao-audit-bound
# truncates it in place once it reaches BOUND (BOUND < MAX). ~230 MB/day of
# audit traffic on this node => truncation roughly every 3-4 hours at 32 MiB.
OPENBAO_AUDIT_LOG_MAX_BYTES=67108864
OPENBAO_AUDIT_LOG_BOUND_BYTES=33554432
OPENBAO_AUDIT_BOUND_INTERVAL_SECONDS=30
