# Isolated Cells conformance instance for tools/component-release/conformance-run.sh
# (.design/07 §8A). A dedicated Compose project, data, secrets, networks and a
# loopback-only port: it shares nothing with kailo-cells-native or platform-local.
# Install two owner-only (0600) copies outside the repo:
#   CONFORMANCE_NATIVE_ENV   = this file WITHOUT the "delivery" section (stage 1/2)
#   CONFORMANCE_DELIVERY_ENV = this file WITH it (stage 3)
# <to-fill> lines need an operator value; never put a credential value here.

CELLS_COMPOSE_PROJECT=kailo-cells-conformance
# Same candidate digests as the release under test (file-storage/fork/upstream.yaml).
CELLS_IMAGE=127.0.0.1:55000/file-storage-service@sha256:<to-fill:file-storage-service>
# Fresh, independent native credentials (start.sh refuses defaults/reuse).
# dbManualDSN ends with the upstream per-service table template (see
# file-storage.env.template).
CELLS_INSTALL_FILE=/var/lib/kailo-ci/conformance/cells/secrets/install.json
CELLS_DB_PASSWORD_FILE=/var/lib/kailo-ci/conformance/cells/secrets/db_password
# start.sh requires the native password connector plus one kailo-oidc connector;
# the isolated instance never federates, so the OIDC client below is a
# dedicated, unused client of the isolated realm/issuer, not the production one.
# Its kailo-oidc config declares "provisionUsers": false (no first-login accounts).
# It also declares "backchannelLogout": {"sessionMaxAgeSeconds": ..., "logoutTokenMaxAgeSeconds": ...} (start.sh checks it, 07 §4.7.5).
CELLS_OAUTH_CONNECTORS='<to-fill:isolated connectors.json>'
CELLS_OIDC_CLIENT_SECRET_FILE=/var/lib/kailo-ci/conformance/cells/secrets/oidc_client_secret
CELLS_OAUTH_SECRET_FILE=/var/lib/kailo-ci/conformance/cells/secrets/oauth_secret.json
# Fresh datasource keys of this instance only (0600; see file-storage.env.template).
CELLS_DATASOURCE_KEY_FILE=/var/lib/kailo-ci/conformance/cells/secrets/datasource_key
CELLS_DATASOURCE_SECRET_FILE=/var/lib/kailo-ci/conformance/cells/secrets/datasource_secret
CELLS_DATA_DIR=/var/lib/kailo-ci/conformance/cells/data
CELLS_DB_DATA_DIR=/var/lib/kailo-ci/conformance/cells/database
# Owner-only (0700) backup directory of start.sh --migrate-tables.
CELLS_MIGRATION_BACKUP_DIR=/var/lib/kailo-ci/conformance/cells/backups
# Disjoint from kailo-cells-native (10.200.2/3.0/24) and platform networks.
CELLS_DATA_SUBNET=10.200.42.0/24
CELLS_UI_SUBNET=10.200.43.0/24
CELLS_DB_NAME=cells
CELLS_DB_USER=cells
CELLS_DB_PORT=5432
CELLS_DB_CPUS=1
CELLS_DB_MEMORY=1g
CELLS_CPUS=2
CELLS_MEMORY=4g
CELLS_BIND=:8080
CELLS_EXTERNAL=http://127.0.0.1:58192
CELLS_NO_TLS=1
CELLS_CONTAINER_PORT=8080
CELLS_PUBLIC_PORT=58192
CELLS_PUBLIC_ADDRESS=127.0.0.1
CELLS_HEALTH_URL=http://127.0.0.1:8080/a/frontend/bootconf
CELLS_HEALTH_INTERVAL=10s
CELLS_HEALTH_TIMEOUT=5s
CELLS_HEALTH_RETRIES=30
CELLS_HEALTH_START_PERIOD=60s
CELLS_START_TIMEOUT_SECONDS=600
KAILO_FRAME_ANCESTORS=
PLATFORM_DISPLAY_NAME=Kailo
TMPDIR=/var/lib/kailo-ci/tmp
# Declarative native configuration (file-storage/deploy/reconcile.py), same
# shape as production. Stage 1 can grant only the install admin (the only
# native user then); after creating the isolated service and actor users,
# extend CELLS_BINDING_PRINCIPALS / CELLS_BINDING_SERVICE_LOGIN in BOTH env
# files before --stage 2 (it re-applies them). The seed's workspaceSlug is
# CELLS_BINDING_WORKSPACE_SLUG; the admin needs rw there to seed.
CELLS_DRAFT_NAMESPACE=usermeta-kailo-draft
CELLS_BINDING_DATASOURCE=kailobinding
CELLS_BINDING_VERSIONING_POLICY=keep-all
CELLS_BINDING_ROOT_FOLDER=kailo-binding
CELLS_BINDING_WORKSPACE_SLUG=kailo-binding
CELLS_BINDING_WORKSPACE_LABEL='Kailo binding'
CELLS_BINDING_PRINCIPALS='<to-fill:admin-login>:rw'
# Stage 2 on: CELLS_BINDING_PRINCIPALS='<admin>:rw <service>:r <actor>:rw'
CELLS_BINDING_SERVICE_LOGIN=
CELLS_BINDING_FACTS_FILE=/var/lib/kailo-ci/conformance/cells/binding/facts.json

# ---- delivery (stage 3 only) ----
CELLS_ADAPTER_IMAGE=127.0.0.1:55000/file-storage-adapter@sha256:<to-fill:file-storage-adapter = manifest adapterBuildRef>
CELLS_ADAPTER_UID=1000
CELLS_ADAPTER_GID=1000
CELLS_ADAPTER_CPUS=0.5
CELLS_ADAPTER_MEMORY=256m
# Rendered by adapter-delivery.py config from the isolated plan
# (tools/component-release/conformance/isolated-plan.py: fresh simulated
# tenant/binding/actor/result-policy ids, the same ones observe.json and the
# suite provider use; never a component-bind.mjs production plan) with the
# explicit isolated endpoints
#   --core-pep-url http://conformance-provider:<port>/service/v1/adapter/pep_check
#   --oidc-token-url http://conformance-provider:<port>/oidc/token
#   --action-token-audience <isolated identity audience, not kailo-adapter-file-storage>
#   --action-token-signing-file <Core's COMPONENT_CONFORMANCE_SIGNING_FILE> (issuer)
# (the native action delivery, --kind cells-native, takes the same two URLs);
# actionTokenJwksFile = CONFORMANCE_ADAPTER_JWKS.
# Its validation.secretDeliveries are rendered by an OpenBao Agent of an
# isolated OpenBao (never platform-local-openbao) for tenants/<simulated tenant>/:
# tools/component-release/conformance/isolated-openbao.sh, run by conformance-run.sh
# stage 3 before start.sh --check when CONFORMANCE_OPENBAO_ENV is set (cells_bearer = the isolated
# instance's service PAT, oidc_client_secret = the suite provider binding secret).
CELLS_ADAPTER_DELIVERY_DIR=/var/lib/kailo-ci/conformance/cells/adapter-delivery
CELLS_ADAPTER_CONFIG_FILE=/var/lib/kailo-ci/conformance/cells/adapter-delivery/adapter.json
# The run's dedicated network (CONFORMANCE_NETWORK), never platform-local_app.
CELLS_ADAPTER_PLATFORM_NETWORK=kailo-conformance-file-storage
CELLS_NATIVE_ACTION_DELIVERY_DIR=/var/lib/kailo-ci/conformance/cells/native-action
CELLS_NATIVE_ACTION_CONFIG_FILE=/var/lib/kailo-ci/conformance/cells/native-action/native.json
