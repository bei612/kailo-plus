# Isolated Cells conformance instance for tools/component-release/conformance-run.sh
# (.design/07 §8A). A dedicated Compose project, data, secrets, networks and a
# loopback-only port: it shares nothing with kailo-cells-native or platform-local.
# Install two owner-only (0600) copies outside the repo:
#   CONFORMANCE_NATIVE_ENV   = this file WITHOUT the "delivery" section (stage 1/2)
#   CONFORMANCE_DELIVERY_ENV = this file WITH it (stage 3)
# <to-fill> lines need an operator value; never put a credential value here.

CELLS_COMPOSE_PROJECT=kailo-cells-conformance
# Same candidate digests as the release under test (file-storage/fork/upstream.yaml).
CELLS_IMAGE=127.0.0.1:55000/file-storage-service@sha256:<to-fill:file-storage-service>
# Fresh, independent native credentials (start.sh refuses defaults/reuse).
CELLS_INSTALL_FILE=/volumes/data/kailo/conformance/cells/secrets/install.json
CELLS_DB_PASSWORD_FILE=/volumes/data/kailo/conformance/cells/secrets/db_password
# start.sh requires the native password connector plus one kailo-oidc connector;
# the isolated instance never federates, so the OIDC client below is a
# dedicated, unused client of the isolated realm/issuer, not the production one.
CELLS_OAUTH_CONNECTORS='<to-fill:isolated connectors.json>'
CELLS_OIDC_CLIENT_SECRET_FILE=/volumes/data/kailo/conformance/cells/secrets/oidc_client_secret
CELLS_OAUTH_SECRET_FILE=/volumes/data/kailo/conformance/cells/secrets/oauth_secret.json
CELLS_DATA_DIR=/volumes/data/kailo/conformance/cells/data
CELLS_DB_DATA_DIR=/volumes/data/kailo/conformance/cells/database
# Disjoint from kailo-cells-native (10.200.2/3.0/24) and platform networks.
CELLS_DATA_SUBNET=10.200.42.0/24
CELLS_UI_SUBNET=10.200.43.0/24
CELLS_DB_NAME=cells
CELLS_DB_USER=cells
CELLS_DB_PORT=5432
CELLS_DB_CPUS=1
CELLS_DB_MEMORY=1g
CELLS_CPUS=2
CELLS_MEMORY=4g
CELLS_BIND=:8080
CELLS_EXTERNAL=http://127.0.0.1:58192
CELLS_NO_TLS=1
CELLS_CONTAINER_PORT=8080
CELLS_PUBLIC_PORT=58192
CELLS_PUBLIC_ADDRESS=127.0.0.1
CELLS_HEALTH_URL=http://127.0.0.1:8080/a/frontend/bootconf
CELLS_HEALTH_INTERVAL=10s
CELLS_HEALTH_TIMEOUT=5s
CELLS_HEALTH_RETRIES=30
CELLS_HEALTH_START_PERIOD=60s
CELLS_START_TIMEOUT_SECONDS=600
KAILO_FRAME_ANCESTORS=
TMPDIR=/volumes/data/kailo/tmp

# ---- delivery (stage 3 only) ----
CELLS_ADAPTER_IMAGE=127.0.0.1:55000/file-storage-adapter@sha256:<to-fill:file-storage-adapter = manifest adapterBuildRef>
CELLS_ADAPTER_UID=1000
CELLS_ADAPTER_GID=1000
CELLS_ADAPTER_CPUS=0.5
CELLS_ADAPTER_MEMORY=256m
# Rendered by adapter-delivery.py config from the isolated plan (simulated
# binding/tenant ids of observe.json) with the explicit isolated endpoints
#   --core-pep-url http://conformance-provider:<port>/service/v1/adapter/pep_check
#   --oidc-token-url http://conformance-provider:<port>/oidc/token
#   --action-token-audience <isolated identity audience, not kailo-adapter-file-storage>
#   --action-token-signing-file <Core's COMPONENT_CONFORMANCE_SIGNING_FILE> (issuer)
# (the native action delivery, --kind cells-native, takes the same two URLs);
# actionTokenJwksFile = CONFORMANCE_ADAPTER_JWKS.
# Its validation.secretDeliveries are rendered by an OpenBao Agent of an
# isolated OpenBao (never platform-local-openbao) for tenants/<simulated tenant>/.
CELLS_ADAPTER_DELIVERY_DIR=/volumes/data/kailo/conformance/cells/adapter-delivery
CELLS_ADAPTER_CONFIG_FILE=/volumes/data/kailo/conformance/cells/adapter-delivery/adapter.json
# The run's dedicated network (CONFORMANCE_NETWORK), never platform-local_app.
CELLS_ADAPTER_PLATFORM_NETWORK=kailo-conformance-file-storage
CELLS_NATIVE_ACTION_DELIVERY_DIR=/volumes/data/kailo/conformance/cells/native-action
CELLS_NATIVE_ACTION_CONFIG_FILE=/volumes/data/kailo/conformance/cells/native-action/native.json
