  "adapterProtocolRange": "NONE",
  "frontendDelivery": {
    "mode": "NATIVE_PAGE",
    "extensionSlots": [],
    "editorOrigins": [],
    "nativePageOrigins": [
      "{{nativePageOrigin}}"
    ],
    "nativePageCategory": "file_storage"
  },
  "executionConnector": {
    "mode": "NONE",
    "adapterProtocolRange": "NONE",
    "actionTokenAudience": "NONE"
  },
  "adapterBuildRef": "{{adapterBuildRef}}",
  "implements": [],
  "capabilityDeclarations": [],
