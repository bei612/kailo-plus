    "NONE"
  ],
  "dataStoreIsolation": "DEDICATED_INSTANCE",
  "dataLocation": "Platform-operated dedicated Cells instance with its own database and object storage on the deployment's private component network.",
  "secretSchema": [],
  "targetResourceTypeKeys": [],
  "resourceTypeDefinitions": [],
  "actionDefinitions": [],
  "toolDefinitions": [],
  "businessObservabilityContract": {
    "correlationSources": [
      "OPERATION_ID"
    ],
    "businessStateSources": [
      "CORE_ACTION"
    ],
    "aggregationDimensions": [
      "tenant_id",
      "workspace_id"
    ],
    "redactionPolicy": "PLATFORM_METADATA_ONLY"
  },
  "frontendPresentationContract": {
    "integrationMode": "KAILO_EMBED",
    "themeMapping": {"LIGHT": "mui3-light", "DARK": "mui3-dark"},
    "localeMapping": {"ZH_CN": "zh-cn", "EN": "en-us"},
    "themeChangePolicy": "LIVE",
    "localeResolutionPolicy": "BROWSER_RESOLVED",
    "preferences": [
      {
        "key": "documents.measurementUnit",
        "settingsCategory": "DOCUMENTS",
        "valueType": "ENUM",
        "options": [
          {"value": "cm", "label": {"ZH_CN": "厘米", "EN": "Centimeters"}},
          {"value": "pt", "label": {"ZH_CN": "点", "EN": "Points"}},
          {"value": "inch", "label": {"ZH_CN": "英寸", "EN": "Inches"}}
        ],
        "defaultValue": "cm",
        "label": {"ZH_CN": "度量单位", "EN": "Measurement unit"},
        "description": {"ZH_CN": "文档编辑器中标尺、页边距与段落间距使用的单位", "EN": "Unit for rulers, margins and paragraph spacing in the document editor"}
      },
      {
        "key": "documents.spellcheck",
        "settingsCategory": "DOCUMENTS",
        "valueType": "BOOLEAN",
        "options": [],
        "defaultValue": "true",
        "label": {"ZH_CN": "拼写检查", "EN": "Spell checking"},
        "description": {"ZH_CN": "在文档编辑器中标出拼写错误", "EN": "Underline misspelled words in the document editor"}
      },
      {"key":"appearance.listDensity","settingsCategory":"APPEARANCE","valueType":"ENUM","options":[{"value":"comfortable","label":{"ZH_CN":"舒适","EN":"Comfortable"}},{"value":"compact","label":{"ZH_CN":"紧凑","EN":"Compact"}}],"defaultValue":"comfortable","label":{"ZH_CN":"列表密度","EN":"List density"},"description":{"ZH_CN":"列表与表格的行高","EN":"Row height of lists and tables"}}
    ],
    "adminSurfaces": [
      {
        "key": "storage.dataSources",
        "adminCategory": "STORAGE",
        "path": "/kailo-admin/data-sources",
        "requiredPermission": "TENANT_MANAGE",
        "access": "READ_ONLY",
        "title": {"ZH_CN": "文件存储位置", "EN": "File storage locations"},
        "description": {"ZH_CN": "文件存放的数据源、运行状态与版本保留策略，由部署声明", "EN": "Data sources holding the files, their status and version retention, declared by the deployment"}
      },
      {
        "key": "files.metadata",
        "adminCategory": "SYSTEM",
        "path": "/kailo-admin/metadata",
        "requiredPermission": "TENANT_MANAGE",
        "access": "EDITABLE",
        "title": {"ZH_CN": "文件元数据字段", "EN": "File metadata fields"},
        "description": {"ZH_CN": "成员可为文件与文件夹填写的自定义字段，如标签、评分与选项", "EN": "Custom fields members can fill in on files and folders, such as tags, ratings and choices"}
      }
    ]
  }
}
