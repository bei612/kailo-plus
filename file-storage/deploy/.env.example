# Delivery configuration only. No credentials, generated secrets, or guessed addresses.
# Native install JSON: cmd/install-ni.go::NiInstallConfig; see verify/deployment.md.
CELLS_COMPOSE_PROJECT=
# Recorded native fork image, repository@sha256:...; no upstream binary default.
CELLS_IMAGE=
# Its dbManualDSN keeps the upstream query template
# prefix={{.Meta.prefix}}&policies={{.Meta.policies}}&singular={{.Meta.singular}}.
CELLS_INSTALL_FILE=
CELLS_DB_PASSWORD_FILE=
# Native connectors JSON, including the existing explicit issuer/sub to Cells UUID links.
# The kailo-oidc connector's clientSecretFile is /run/secrets/cells_oidc_client_secret.
# Its config must declare "provisionUsers" (true/false, no default): true adds
# "provisionProfile": "standard" and creates a standard native account on the
# first login of an unlinked subject (DD-127(9)); false keeps explicit links only.
# With provisioning it also declares "organization": {"tenant": {id, name}}
# (the one Kailo Tenant served, 07 §4.7.4), always "backchannelLogout":
# {sessionMaxAgeSeconds, logoutTokenMaxAgeSeconds} (07 §4.7.5) and may declare
# "platformLogoutUrl".
CELLS_OAUTH_CONNECTORS=
CELLS_OIDC_CLIENT_SECRET_FILE=
# Owner-only JSON string containing this Cells instance's own OAuth secret.
# This is separate from the external IdP client's secret and platform secrets.
CELLS_OAUTH_SECRET_FILE=
CELLS_DATA_DIR=
CELLS_DB_DATA_DIR=
# Owner-only backup directory, only for start.sh --migrate-tables.
CELLS_MIGRATION_BACKUP_DIR=
CELLS_DATA_SUBNET=
CELLS_UI_SUBNET=
CELLS_DB_NAME=
CELLS_DB_USER=
CELLS_DB_PORT=
CELLS_DB_CPUS=
CELLS_DB_MEMORY=
CELLS_CPUS=
CELLS_MEMORY=
CELLS_BIND=
CELLS_EXTERNAL=
CELLS_NO_TLS=
CELLS_CONTAINER_PORT=
CELLS_PUBLIC_PORT=
CELLS_PUBLIC_ADDRESS=
CELLS_HEALTH_URL=
CELLS_HEALTH_INTERVAL=
CELLS_HEALTH_TIMEOUT=
CELLS_HEALTH_RETRIES=
CELLS_HEALTH_START_PERIOD=
CELLS_START_TIMEOUT_SECONDS=
TMPDIR=

# Declarative configuration (reconcile.py); the binding datasource is created
# by the image entrypoint before start (cells admin datasource ensure).
CELLS_DRAFT_NAMESPACE=
CELLS_BINDING_DATASOURCE=
CELLS_BINDING_VERSIONING_POLICY=
CELLS_BINDING_ROOT_FOLDER=
CELLS_BINDING_WORKSPACE_SLUG=
CELLS_BINDING_WORKSPACE_LABEL=
CELLS_BINDING_PRINCIPALS=
CELLS_BINDING_SERVICE_LOGIN=
CELLS_BINDING_FACTS_FILE=

# Optional --platform-adapter mode; no defaults or native service restart.
# Use tools/build-upstream.sh file-storage-adapter for the recorded artifact.
CELLS_ADAPTER_IMAGE=
CELLS_ADAPTER_UID=
CELLS_ADAPTER_GID=
CELLS_ADAPTER_CPUS=
CELLS_ADAPTER_MEMORY=
# Existing owner-only directory containing configuration, public JWKS, rendered
# credentials and the original no-cache OpenBao Agent Unix proxy socket.
# Configuration paths must use this same absolute directory inside the adapter.
CELLS_ADAPTER_DELIVERY_DIR=
CELLS_ADAPTER_CONFIG_FILE=
CELLS_ADAPTER_PLATFORM_NETWORK=

# Optional current HUMAN/AGENT native action consumer, applied by the original
# entrypoint before listeners open. Both fields must be delivered together.
# Separate owner-only directory: the existing nativeActor configuration JSON
# and its binding-authenticated callback clientSecretFile, no inline secrets.
# File paths retain the same absolute names inside the native Cells container.
# The existing CELLS_ADAPTER_PLATFORM_NETWORK also carries the authenticated
# native callback; no separate address/network authority is introduced.
CELLS_NATIVE_ACTION_DELIVERY_DIR=
CELLS_NATIVE_ACTION_CONFIG_FILE=
# Kailo deployment display name (platform .env), title "<name> 云盘" (DD-133 §1).
PLATFORM_DISPLAY_NAME=
