# syntax=docker/dockerfile:1.7

# Native GUI sources are embedded by frontend/assets.go at Go compile time.
# Build the complete original pnpm workspace before that consumer runs, rather
# than embedding the tracked bundles from an older source revision.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS frontend
WORKDIR /src/frontend/assets
COPY frontend/assets/ ./
RUN apk add --no-cache bash git && corepack enable
SHELL ["/bin/bash", "-e", "-o", "pipefail", "-c"]
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 npm_config_store_dir=/pnpm/store
COPY adapter/src/native-reference.mjs /src/adapter/src/native-reference.mjs
RUN --mount=type=cache,id=cells-ui-corepack,target=/root/.cache/node/corepack \
    --mount=type=cache,id=cells-ui-pnpm,target=/pnpm/store \
    bash ./build.sh && \
    mkdir /out && \
    tar --exclude=node_modules -cf - . | tar -xf - -C /out
#
# Pydio Cells native-source container image.
#
# Kailo fork artifact always compiles this source (context = repo root).
# Official registry indices were read on 2026-10-05; no base image is floating.

# ── Stage: compile from source ───────────────────────────────────────
FROM golang:1.26.8-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS compile
ARG TARGETARCH
ARG CELLS_VERSION
ARG GIT_REV=dev
ARG BUILD_STAMP
RUN apk add --no-cache git make
WORKDIR /src
COPY . .
# Replace the old embed tree, including obsolete webpack chunks removed by the
# original production clean rules. Dependency stores never enter the binary.
RUN rm -rf /src/frontend/assets
COPY --from=frontend /out/ ./frontend/assets/
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    GOTOOLCHAIN=local CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} \
    go build -mod=readonly -trimpath \
      -ldflags "-X github.com/pydio/cells/v5/common.version=${CELLS_VERSION} \
                -X github.com/pydio/cells/v5/common.BuildStamp=${BUILD_STAMP} \
                -X github.com/pydio/cells/v5/common.BuildRevision=${GIT_REV}" \
      -o /out/cells . \
    && /out/cells version

# ── Stage: select binary source ──────────────────────────────────────
FROM compile AS binary

# ── Final runtime image ──────────────────────────────────────────────
FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
ARG CELLS_VERSION
ARG GIT_REV
ARG BUILD_STAMP
ARG TARGETARCH
ARG DOCKER_ENTRYPOINT_SRC_DIR=.

LABEL org.opencontainers.image.title="Pydio Cells" \
      org.opencontainers.image.description="Pydio Cells — enterprise file sharing and collaboration platform" \
      org.opencontainers.image.vendor="Pydio" \
      org.opencontainers.image.source="https://github.com/pydio/cells" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.version="${CELLS_VERSION}" \
      org.opencontainers.image.revision="${GIT_REV}" \
      org.opencontainers.image.created="${BUILD_STAMP}"

RUN apk add --no-cache ca-certificates tini tzdata

ENV CELLS_WORKING_DIR=/var/cells
WORKDIR ${CELLS_WORKING_DIR}

COPY --from=binary --chmod=0755 /out/cells /opt/pydio/bin/cells
COPY --chmod=0755 ${DOCKER_ENTRYPOINT_SRC_DIR}/docker-entrypoint.sh /opt/pydio/bin/docker-entrypoint.sh
ENV PATH="/opt/pydio/bin:${PATH}"

RUN printf 'Pydio Cells Home Docker Image\n  Alpine %s / arch %s\n  Version %s built on %s (rev %s)\n' \
      "$(cat /etc/alpine-release)" "${TARGETARCH}" "${CELLS_VERSION}" "${BUILD_STAMP:-unknown}" "${GIT_REV:-unknown}" \
      > /opt/pydio/package.info

VOLUME ["/var/cells"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- --no-check-certificate https://127.0.0.1:8080/a/frontend/bootconf >/dev/null 2>&1 \
   || wget -qO- http://127.0.0.1:8080/a/frontend/bootconf >/dev/null 2>&1 \
   || exit 1

ENTRYPOINT ["/sbin/tini", "--", "docker-entrypoint.sh"]
CMD ["cells", "start"]
