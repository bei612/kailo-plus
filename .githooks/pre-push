#!/usr/bin/env sh
# ADR-07: verify the published commit, not unrelated worktree changes.
# The hook is an early check, not remote branch protection.
set -eu
root=$(git rev-parse --show-toplevel)
zero_oid=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_ref" = '(delete)' ] && [ "$local_oid" = "$zero_oid" ]; then
    continue
  fi
  if ! git rev-parse --verify "$local_oid^{commit}" >/dev/null 2>&1; then
    printf '拒绝 push：%s 的 local_oid %s 不能解析为 commit\n' "$local_ref" "$local_oid" >&2
    exit 1
  fi
  CHECK_SOURCE_REF="$local_oid" "$root/tools/check.sh" --full
done
