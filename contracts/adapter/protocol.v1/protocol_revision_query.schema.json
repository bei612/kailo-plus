{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter/protocol.v1/protocol_revision_query.schema.json",
  "title": "ProtocolRevisionQuery",
  "description": "DD-90/18§5.4：原保存结果不明会话的确切写入证据查证；只核已有 ACCEPTED writer observation 对应的原生 VersionId，不提供文件字节或当前权限。",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolSessionId", "baseRevision", "writeObservation"],
  "properties": {
    "protocolSessionId": {"type": "string", "format": "uuid"},
    "baseRevision": {"type": "string"},
    "writeObservation": {"$ref": "protocol_write_observation.schema.json"}
  }
}
