{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter/file_storage.v1/read_input.schema.json",
  "title": "FileStorageReadInput",
  "description": "Read the exact typed native file revision in the admitted Resource; never substitute the current head.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resourceId", "nativeObjectRef", "nativeRevision", "displayName", "mediaType"],
  "properties": {
    "resourceId": {"type": "string", "format": "uuid"},
    "nativeObjectRef": {"type": "string"},
    "nativeRevision": {"type": "string"},
    "displayName": {"type": "string"},
    "mediaType": {"type": "string"}
  }
}
