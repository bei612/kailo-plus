  "contentReferenceSemantics": {
    "nativeObjectRefRule": "Read/export/ingest use the native knowledge document identifier in the typed ContentReference slot. Search preserves source-native object identifiers from internal ingestion metadata in typed contentReferences; no reference is identified or rebuilt from resultJson.",
    "nativeRevisionRule": "Read/export/delete consume the frozen native knowledge document revision and reject a different revision. Search citations preserve the exact source revision recorded by ingestion; opening a citation reauthorizes and resolves that source reference.",
    "authorizationTargetRule": "The admitted KnowledgeBase Resource owns read/export/ingest document references. Search returns citations from guarded internal source metadata in the typed contentReferences slot, identically mirrored by resultJson.citations; source references retain their original Resource/Asset ownership and opening them requires current source read authorization. Ingest consumes a source file ContentReference through READ_EDGE while retaining the receiver KnowledgeBase as its action target; no caller-supplied native tenant or knowledge-base override."
  },
  "requiredDeclarations": [
    "CANCEL",
    "OBSERVE",
    "METER",
    "TENANT_DELETE",
    "READ_EDGE"
  ],
