{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain/capability_conformance_vectors.schema.json",
  "title": "CapabilityConformanceVectors",
  "description": "DD-102 / ADR-12：能力契约固定的机器向量。每个 case 按 steps 顺序执行契约操作，参数与预期结果是实际 JSON，不执行文本代码。格式有效不表示组件套件通过；线协议性质、真实执行与 release 证据关联另行核验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "cases"],
  "properties": {
    "formatVersion": {"$ref": "../enums/capability_vector_format.schema.json"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseKey", "steps"],
        "properties": {
          "caseKey": {"type": "string"},
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stepKey", "contractKey", "inputJson", "expectedOutputJson"],
              "properties": {
                "stepKey": {"type": "string"},
                "contractKey": {"type": "string"},
                "inputJson": {"type": "string"},
                "expectedOutputJson": {"type": "string"},
                "referenceResourceId": {"type": "string", "format": "uuid"},
                "referenceAssetId": {"type": "string", "format": "uuid"},
                "referenceFromStepKey": {"type": "string", "description": "只引用同 case 已成功的更早 stepKey 的唯一 typed ContentReference；不得指定 JSON 路径或表达式。与固定 Resource/Asset 目标一起进入规范化参数 hash。"}
              }
            }
          }
        }
      }
    }
  }
}
