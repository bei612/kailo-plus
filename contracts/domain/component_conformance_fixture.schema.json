{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain/component_conformance_fixture.schema.json",
  "title": "ComponentConformanceFixture",
  "description": "隔离开发环境受控投递的协议夹具数据，不来自登记请求。Core 只采用固定协议用例并核对全部必需覆盖；没有脚本、条件、路径表达式或通过声明。",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactDigest", "steps"],
  "properties": {
    "artifactDigest": {"type": "string"},
    "steps": {"$ref": "../workflow/component_conformance_plan.schema.json#/properties/steps"},
    "preconditions": {
      "type": "array",
      "description": "DD-124(1)：V2 契约 case 声明的前置原生对象取值。只能是候选实现原生入口创建时实际返回的标识；Core 在冻结计划时代入，并核对每个声明恰有一个取值。不是期望值来源。",
      "items": {
        "title": "ComponentConformancePreconditionValue",
        "type": "object", "additionalProperties": false,
        "required": ["caseKey", "key", "value"],
        "properties": {
          "caseKey": {"type": "string", "description": "计划内 case 键 <categoryKey>:<contractVersion>:<caseKey>。"},
          "key": {"type": "string"},
          "value": {"type": "string"}
        }
      }
    },
    "nativeReceivers": {
      "type": "array",
      "items": {
        "title": "ComponentNativeReceiverFixture",
        "type": "object", "additionalProperties": false,
        "required": ["caseKey", "stepKey", "contractKey", "request"],
        "properties": {
          "caseKey": {"type": "string"},
          "stepKey": {"type": "string"},
          "contractKey": {"type": "string"},
          "request": {"$ref": "component_native_receiver_request.schema.json"}
        }
      }
    }
  }
}
