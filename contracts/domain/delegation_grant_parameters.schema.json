{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain/delegation_grant_parameters.schema.json",
  "title": "DelegationGrantParameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["validFrom", "expiresAt", "scopes"],
  "properties": {
    "validFrom": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "maxUses": {"type": "integer", "minimum": 1},
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "delegation_scope_parameters.schema.json"}
    },
    "renewsDelegationId": {"type": "string", "format": "uuid", "description": "DD-126(5)：续签时被替换的本人 Grant；与 renewsDelegationVersion 成对出现，缺省为新授予。"},
    "renewsDelegationVersion": {"type": "integer", "minimum": 1, "description": "DD-126(5)：被替换 Grant 的当前 version（CAS）。"}
  }
}
