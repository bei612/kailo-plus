{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain/delegation_grant_parameters.schema.json",
  "title": "DelegationGrantParameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["validFrom", "expiresAt", "scopes"],
  "properties": {
    "validFrom": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "maxUses": {"type": "integer", "minimum": 1},
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actionKey", "actionVersion", "targetType", "resultExposureMode", "outputSchemaHash", "redactionPolicy"],
        "properties": {
          "actionKey": {"type": "string", "minLength": 1},
          "actionVersion": {"type": "integer", "minimum": 1},
          "targetType": {"type": "string", "minLength": 1},
          "targetId": {"type": "string", "format": "uuid"},
          "createWorkspaceId": {"type": "string", "format": "uuid"},
          "toolResourceId": {"type": "string", "format": "uuid"},
          "resultExposureMode": {"type": "string", "enum": ["CONSUME_ONLY", "READ", "EXPORT"]},
          "outputSchemaHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "redactionPolicy": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
