{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain/component_native_receiver_request.schema.json",
  "title": "ComponentNativeReceiverRequest",
  "description": "07§8A 隔离原生接收方验证的冻结请求。原生生成真实 batch ID；同键重入与观察必须保持全部字段，不是生产 execute 输入或通用 HTTP 脚本。",
  "type": "object",
  "additionalProperties": false,
  "required": ["idempotencyKey", "importConfigRef", "bindingId", "generation", "expiresAt"],
  "properties": {
    "idempotencyKey": {"type": "string", "format": "uuid"},
    "importConfigRef": {"type": "string", "format": "uuid"},
    "bindingId": {"type": "string", "format": "uuid"},
    "generation": {"type": "integer"},
    "expiresAt": {"type": "string", "description": "受控夹具固定的 RFC3339 首派期限，须受原生 SyncLog 保留策略约束；过期仍可观察同一批次，不得续期重派。"}
  }
}
