{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain/automation_secret_ref.schema.json",
  "title": "AutomationSecretRef",
  "description": "同 Tenant OpenBao KV v2 的精确版本引用（DD-70）；只是 locator，不含密钥正文。audience 必须是 Core 的服务身份。",
  "type": "object",
  "additionalProperties": false,
  "required": ["locator", "version", "audience"],
  "properties": {
    "locator": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "audience": {"type": "string", "minLength": 1}
  }
}
