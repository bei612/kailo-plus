{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain/application_adapter_directory.schema.json",
  "title": "ApplicationAdapterDirectory",
  "description": "DD-94部署投递面：adapter服务引用解析到固定部署产物/原生实例与受限传输。不是Catalog或业务授权。",
  "type": "object", "additionalProperties": false, "required": ["adapters"],
  "properties": {
    "adapters": {"type": "array", "items": {
      "title": "ApplicationAdapterDelivery", "type": "object", "additionalProperties": false,
      "required": ["adapterServiceRef", "baseUrl", "nativeInstanceRef", "artifactDigest", "actionTokenAudience", "timeoutSeconds", "maxResponseBytes", "secretReaders"],
      "properties": {
        "adapterServiceRef": {"type": "string"}, "baseUrl": {"type": "string"},
        "mcpUrl": {"type": "string"},
        "nativeInstanceRef": {"type": "string"}, "artifactDigest": {"type": "string"},
        "actionTokenAudience": {"type": "string"}, "timeoutSeconds": {"type": "integer"},
        "maxResponseBytes": {"type": "integer"},
        "modelCredentialDeliveries": {"$ref":"#/$defs/modelCredentialDeliveries"},
        "nativeHumanIdentities": {"type":"array", "description":"受控原生浏览器信任投递；不授业务权限，不由请求提供issuer/subject/key URL。", "items":{
          "title":"ApplicationNativeHumanIdentity", "type":"object", "additionalProperties":false,
          "required":["bindingId","configDigest","generation","identityProviderId","audience","jwksFile","accessClaim","accessValue"],
          "properties":{
            "bindingId":{"type":"string","format":"uuid"},
            "configDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
            "generation":{"type":"integer","minimum":1},
            "identityProviderId":{"type":"string","format":"uuid"},
            "audience":{"type":"string","minLength":1},
            "jwksFile":{"type":"string","minLength":1},
            "accessClaim":{"type":"string","minLength":1},
            "accessValue":{"type":"string","minLength":1}
          }
        }},
        "secretReaders": {"type": "array", "items": {
          "title": "ApplicationSecretReader", "type": "object", "additionalProperties": false,
          "required": ["servicePrincipalId", "roleName", "audience"],
          "properties": {
            "servicePrincipalId": {"type": "string", "format": "uuid"},
            "roleName": {"type": "string"}, "audience": {"type": "string"}
          }
        }}
      }
    }},
    "protocolPeers": {"type": "array", "description": "受控部署事实，不是 Tool 注册表或业务授权；原生 MCP peer 不接收 ActionToken。", "items": {
      "title": "ApplicationProtocolPeerDelivery", "type": "object", "additionalProperties": false,
      "required": ["adapterServiceRef", "mcpUrl", "nativeInstanceRef", "artifactDigest", "timeoutSeconds", "maxResponseBytes", "bindings"],
      "properties": {
        "adapterServiceRef": {"type": "string"}, "mcpUrl": {"type": "string"},
        "nativeInstanceRef": {"type": "string"}, "artifactDigest": {"type": "string"},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "maxResponseBytes": {"type": "integer", "minimum": 1},
        "secretReaders": {"$ref":"#/properties/adapters/items/properties/secretReaders"},
        "modelCredentialDeliveries": {"$ref":"#/$defs/modelCredentialDeliveries"},
        "bindings": {"type": "array", "items": {
          "title": "ApplicationProtocolPeerBindingDelivery", "type": "object", "additionalProperties": false,
          "required": ["bindingId", "tenantId", "servicePrincipalId", "nativeScopeRef", "configDigest", "isolationMode"],
          "properties": {
            "bindingId": {"type": "string", "format": "uuid"},
            "tenantId": {"type": "string", "format": "uuid"},
            "workspaceId": {"type": "string", "format": "uuid"},
            "servicePrincipalId": {"type": "string", "format": "uuid"},
            "nativeScopeRef": {"type": "string"}, "configDigest": {"type": "string"},
            "isolationMode": {"type": "string"},
            "credentialGeneration": {"type":"integer", "minimum":1},
            "nativeCredentials": {"type":"array", "description":"原受控投递映射：无secret值；精确版本由Core以原audience读取并向Gateway独占文件投递。", "items":{
              "title":"ApplicationPeerCredentialDelivery", "type":"object", "additionalProperties":false,
              "required":["secretKey","locator","version","audience","header","prefix"],
              "properties":{
                "secretKey":{"type":"string"},"locator":{"type":"string"},
                "version":{"type":"integer","minimum":1},"audience":{"type":"string"},
                "header":{"type":"string"},"prefix":{"type":"string"}
              }
            }},
            "nativeResources": {"type": "array", "description": "绑定已有原生对象的受控投递事实，不创建对象或授予权限；父项唯一固定实例与作用域。", "items": {
              "title": "ApplicationNativeResourceDelivery", "type": "object", "additionalProperties": false,
              "required": ["typeKey", "nativeType", "nativeRef", "evidenceRef", "evidenceDigest"],
              "properties": {
                "typeKey": {"type": "string"}, "nativeType": {"type": "string"},
                "nativeRef": {"type": "string"}, "evidenceRef": {"type": "string"},
                "evidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }}
          }
        }}
      }
    }}
  },
  "$defs": {
    "modelCredentialDeliveries": {"type":"array", "description":"受控原生模型凭据交接回执；无密钥值，不创建模型，不替代OpenBao审计或binding准入。", "items":{
      "title":"ApplicationModelCredentialDelivery", "type":"object", "additionalProperties":false,
      "required":["bindingId","generation","configDigest","servicePrincipalId","routeResourceId","nativeScopeRef","nativeModelRef","secretRef","requestId","verificationNonce","nativeProof"],
      "properties":{
        "bindingId":{"type":"string","format":"uuid"},
        "generation":{"type":"integer","minimum":1},
        "configDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "servicePrincipalId":{"type":"string","format":"uuid"},
        "routeResourceId":{"type":"string","format":"uuid"},
        "nativeScopeRef":{"type":"string"},"nativeModelRef":{"type":"string"},
        "secretRef":{"title":"ApplicationModelServiceSecretRef","type":"object","additionalProperties":false,
          "required":["locator","version","audience"],"properties":{
            "locator":{"type":"string"},"version":{"type":"integer","minimum":1},"audience":{"type":"string"}
          }},
        "requestId":{"type":"string","format":"uuid"},
        "verificationNonce":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "nativeProof":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    }}
  }
}
