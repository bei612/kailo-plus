{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/legacy_secret_ref_page.schema.json",
  "title": "LegacySecretRefPage",
  "description": "GET /api/v1/identity/legacy-secret-refs 的有界视图。只列当前 Tenant 中可发起 DD-85 归位的 SERVER binding，不暴露 locator、版本或私钥。",
  "type": "object",
  "additionalProperties": false,
  "required": ["bindings"],
  "properties": {
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "LegacySecretRefBinding",
        "description": "业务 Tenant 的旧 SERVER 身份引用；仅给有 tenant manage 权限的人展示。",
        "additionalProperties": false,
        "required": ["principalId", "pubkey", "kind"],
        "properties": {
          "principalId": { "type": "string", "format": "uuid" },
          "pubkey": { "type": "string" },
          "kind": { "type": "string", "enum": ["HUMAN", "CONTROL"] }
        }
      }
    },
    "nextCursor": { "type": "string" }
  }
}
