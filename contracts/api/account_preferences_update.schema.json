{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/account_preferences_update.schema.json",
  "title": "AccountPreferencesUpdate",
  "description": "PUT /api/v1/account/preferences (DD-164(7)): compare-and-swap on version; absent fields are unchanged, componentPreferences entries are merged by key and a null value removes the key. 409 returns the current AccountPreferences.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expectedVersion"
  ],
  "properties": {
    "expectedVersion": {
      "type": "integer",
      "minimum": 0
    },
    "theme": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "followSystem": {
      "type": "boolean"
    },
    "locale": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en"
      ]
    },
    "componentPreferences": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "string",
          "null"
        ]
      }
    }
  }
}
