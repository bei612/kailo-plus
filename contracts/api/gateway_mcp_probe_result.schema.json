{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/gateway_mcp_probe_result.schema.json",
  "title": "GatewayMcpProbeResult",
  "description": "DD-134(5)②：经 Gateway 临时验证 route 的 initialize 与 tools/list 结果（route 已删除并回读不存在）。matchingContracts 为输入 schema 摘要一致的 ACTIVE 契约 TOOL 键，并带该契约生成 PROTOCOL_PEER release 草稿所需的 Catalog 元数据（DD-134(5)③④），不含 schema 正文。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "probeId",
    "adapterServiceRef",
    "probedAt",
    "toolSchemaDigest",
    "tools"
  ],
  "properties": {
    "probeId": {
      "type": "string",
      "format": "uuid"
    },
    "adapterServiceRef": {
      "type": "string"
    },
    "probedAt": {
      "type": "string",
      "format": "date-time"
    },
    "serverName": {
      "type": "string"
    },
    "serverVersion": {
      "type": "string"
    },
    "protocolVersion": {
      "type": "string"
    },
    "toolSchemaDigest": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "title": "GatewayMcpProbedTool",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "inputSchemaJson",
          "inputSchemaDigest",
          "matchingContracts"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "displayTitle": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "inputSchemaJson": {
            "type": "string"
          },
          "inputSchemaDigest": {
            "type": "string"
          },
          "outputSchemaJson": {
            "type": "string"
          },
          "outputSchemaDigest": {
            "type": "string"
          },
          "readOnlyHint": {
            "type": "boolean"
          },
          "matchingContracts": {
            "type": "array",
            "items": {
              "title": "GatewayMcpContractMatch",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "categoryKey",
                "contractVersion",
                "contractKey",
                "permission",
                "targetType",
                "outputSchemaDigest",
                "resourceTypeKeys",
                "operationContractKeys"
              ],
              "properties": {
                "categoryKey": {
                  "type": "string"
                },
                "contractVersion": {
                  "type": "integer"
                },
                "contractKey": {
                  "type": "string"
                },
                "permission": {
                  "$ref": "../enums/capability_permission.schema.json"
                },
                "targetType": {
                  "type": "string",
                  "description": "该 TOOL 契约键在 ACTIVE 契约中的 targetType。"
                },
                "outputSchemaDigest": {
                  "type": "string",
                  "description": "该 TOOL 契约键在 ACTIVE 契约中的输出 schema 摘要；release 的动作与工具逐字采用。"
                },
                "resourceTypeKeys": {
                  "type": "array",
                  "description": "该 ACTIVE 契约 resourceTypeFamily 的全部 typeKey；release 须逐一登记。",
                  "items": {
                    "type": "string"
                  }
                },
                "operationContractKeys": {
                  "type": "array",
                  "description": "该 ACTIVE 契约的全部 operation 契约键；release 须为每个键登记动作与工具。",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
