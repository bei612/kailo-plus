{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/projects_query_request.schema.json",
  "title": "ProjectsQueryRequest",
  "description": "Original Buzz Community project/repository announcements, coordinate-scoped work-item events and tombstones. Reads do not authorize Git transport or mutations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["view"],
  "properties": {
    "view": {"type": "string", "enum": ["PROJECTS", "REPOSITORIES", "DELETIONS", "WORK_ITEMS", "WORK_ITEM_ACTIVITY"]},
    "coordinates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(30617|30621):[0-9a-f]{64}:.+$"}},
    "since": {"type": "integer", "minimum": 0},
    "until": {"type": "integer", "minimum": 0}
  }
}
