{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/delegated_action_metadata_v1.schema.json",
  "title": "DelegatedActionMetadataV1",
  "description": "已授权普通 Action 的 v1 平台元数据结果；不含业务正文、邀请凭证、文档或协议会话。仅 agent.invoke、automation.run 及已接入普通 resource 动作使用；与通用 BFF ActionSubmission 的可选扩展解耦。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationId",
    "actionExecutionId",
    "actionKey",
    "gateState",
    "dispatchState"
  ],
  "properties": {
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "actionExecutionId": {
      "type": "string",
      "format": "uuid"
    },
    "actionKey": {
      "type": "string"
    },
    "gateState": {
      "$ref": "../enums/action_gate_state.schema.json"
    },
    "dispatchState": {
      "$ref": "../enums/action_dispatch_state.schema.json"
    },
    "reason": {
      "$ref": "../enums/reason_code.schema.json"
    },
    "approvalWorkflowId": {
      "type": "string"
    },
    "workflowId": {
      "type": "string"
    }
  }
}
