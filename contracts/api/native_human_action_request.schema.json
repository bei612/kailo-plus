{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"api/native_human_action_request.schema.json",
  "title":"NativeHumanActionRequest",
  "description":"Binding SERVICE plus independently verified native HUMAN token. Submit an existing ActionCommand or observe the same user's idempotency key. Tokens stay in transport, not this document.",
  "type":"object", "additionalProperties":false,
  "required":["bindingId"],
  "properties":{
    "bindingId":{"type":"string","format":"uuid"},
    "command":{"$ref":"action_command.schema.json"},
    "idempotencyKey":{"type":"string","format":"uuid"},
    "sourceResources":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"$ref":"../adapter/protocol.v1/source_resource.schema.json"}
    },
    "resolveResource":{
      "title":"NativeHumanResourceQuery",
      "description":"Read the already-registered exact native object for the verified HUMAN and action. This never creates a Resource or native object.",
      "type":"object","additionalProperties":false,
      "required":["actionKey","actionVersion","nativeType","nativeRef"],
      "properties":{
        "workspaceId":{"type":"string","format":"uuid"},
        "actionKey":{"type":"string","minLength":1},
        "actionVersion":{"type":"integer","minimum":1},
        "nativeType":{"type":"string","minLength":1},
        "nativeRef":{"type":"string","minLength":1}
      }
    }
  },
  "oneOf":[
    {"required":["command"],"not":{"anyOf":[{"required":["idempotencyKey"]},{"required":["resolveResource"]},{"required":["sourceResources"]}]}},
    {"required":["idempotencyKey"],"not":{"anyOf":[{"required":["command"]},{"required":["resolveResource"]}]}},
    {"required":["resolveResource"],"not":{"anyOf":[{"required":["command"]},{"required":["idempotencyKey"]},{"required":["sourceResources"]}]}}
  ]
}
