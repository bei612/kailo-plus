{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"api/native_human_action_request.schema.json",
  "title":"NativeHumanActionRequest",
  "description":"Binding SERVICE transport. Command, observation and scope/resource access additionally require the independently verified native HUMAN token. readReceipt is SERVICE-only incurred-usage metadata for the already admitted original HUMAN SYNC operation; it never authorizes content disclosure. Tokens stay in transport, not this document.",
  "type":"object", "additionalProperties":false,
  "required":["bindingId"],
  "properties":{
    "bindingId":{"type":"string","format":"uuid"},
    "command":{"$ref":"action_command.schema.json"},
    "readReceipt":{"$ref":"native_human_read_receipt.schema.json"},
    "idempotencyKey":{"type":"string","format":"uuid"},
    "sourceResources":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"$ref":"../adapter/protocol.v1/source_resource.schema.json"}
    },
    "authorizeScope":{
      "title":"NativeHumanScopeQuery",
      "description":"Native metadata access uses existing tenant/workspace permissions. Scope and identity come exclusively from the authenticated binding and HUMAN token, never from client-selected IDs. This is not Action admission or a reusable ticket.",
      "type":"object","additionalProperties":false,
      "required":["permission"],
      "properties":{"permission":{"type":"string","enum":["discover","manage"]}}
    },
    "resolveResource":{
      "title":"NativeHumanResourceQuery",
      "description":"Read the already-registered exact native object for the verified HUMAN and action. This never creates a Resource or native object.",
      "type":"object","additionalProperties":false,
      "required":["actionKey","actionVersion","nativeType","nativeRef"],
      "properties":{
        "workspaceId":{"type":"string","format":"uuid"},
        "actionKey":{"type":"string","minLength":1},
        "actionVersion":{"type":"integer","minimum":1},
        "nativeType":{"type":"string","minLength":1},
        "nativeRef":{"type":"string","minLength":1}
      }
    }
  },
  "oneOf":[
    {"required":["readReceipt"],"not":{"anyOf":[{"required":["command"]},{"required":["idempotencyKey"]},{"required":["resolveResource"]},{"required":["sourceResources"]},{"required":["authorizeScope"]}]}},
    {"required":["command"],"not":{"anyOf":[{"required":["readReceipt"]},{"required":["idempotencyKey"]},{"required":["resolveResource"]},{"required":["sourceResources"]},{"required":["authorizeScope"]}]}},
    {"required":["idempotencyKey"],"not":{"anyOf":[{"required":["readReceipt"]},{"required":["command"]},{"required":["resolveResource"]},{"required":["authorizeScope"]}]}},
    {"required":["resolveResource"],"not":{"anyOf":[{"required":["readReceipt"]},{"required":["command"]},{"required":["idempotencyKey"]},{"required":["sourceResources"]},{"required":["authorizeScope"]}]}},
    {"required":["authorizeScope"],"not":{"anyOf":[{"required":["readReceipt"]},{"required":["command"]},{"required":["idempotencyKey"]},{"required":["sourceResources"]},{"required":["resolveResource"]}]}}
  ]
}
