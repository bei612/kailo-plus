{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/agent_installation_view.schema.json",
  "title": "AgentInstallationView",
  "description": "03 §7、17 §8：同 Tenant、已准入 Workspace 且 fresh Installation Resource read 允许的只读事实；不授予 Version 正文、执行或管理权限。",
  "type": "object",
  "additionalProperties": false,
  "required": ["resourceId", "workspaceId", "agentResourceId", "pinnedVersionAssetId", "agentPrincipalId", "agentPrincipalState", "ownerPrincipalId", "resourceVersion", "resourceState", "state"],
  "properties": {
    "resourceId": {"type": "string", "format": "uuid"},
    "workspaceId": {"type": "string", "format": "uuid"},
    "agentResourceId": {"type": "string", "format": "uuid"},
    "pinnedVersionAssetId": {"type": "string", "format": "uuid"},
    "agentPrincipalId": {"type": "string", "format": "uuid"},
    "agentPubkey": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "原 Installation 的 ACTIVE AGENT BuzzIdentityBinding 公开公钥；经相同 Resource read 准入，仅供原 Inbox owner/作者匹配，不授予执行或签名权限。旧服务缺省不证明身份映射。"},
    "agentPrincipalState": {"type": "string", "enum": ["ACTIVE", "DISABLED"]},
    "ownerPrincipalId": {"type": "string", "format": "uuid"},
    "resourceVersion": {"type": "integer", "minimum": 1},
    "resourceState": {"$ref": "../enums/resource_state.schema.json"},
    "state": {"$ref": "../enums/agent_installation_state.schema.json"},
    "canUpgrade": {"type": "boolean", "description": "当前 ACTIVE 安装可按原 manage 权限申请已发布目标版本；仍须原治理审批，不代表升级已经准入。旧服务缺省不显示入口。"},
    "activeProjectionGeneration": {"type": "integer", "minimum": 1},
    "channelBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "triggers"],
      "properties": {
        "status": {"type": "string", "enum": ["ACTIVE", "DISABLED", "ERROR"]},
        "triggers": {"type": "array", "items": {"$ref": "../enums/agent_trigger.schema.json"}},
        "channelId": {"type": "string", "format": "uuid"}
      }
    },
    "projection": {"$ref": "agent_installation_projection_view.schema.json"},
    "automationResultTargets": {
      "type": "array",
      "description": "同固定 Version、ACTIVE 投影与原生 Profile 已支持的 Automation 来源结果位置；普通 Agent 仍沿其固定回复策略，Automation 则消息到原 Thread、Schedule/manual 到同 Workspace Channel。不代表 execute、Delegation 或 quota 准入。缺失或空集合不支持 Schedule。",
      "items": {"$ref": "../enums/automation_result_target.schema.json"}
    },
    "readPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "effective", "canGrant", "canRevoke"],
      "properties": {
        "requested": {"type": "boolean"},
        "effective": {"type": "boolean"},
        "canGrant": {"type": "boolean"},
        "canRevoke": {"type": "boolean"},
        "pendingActionExecutionId": {"type": "string", "format": "uuid"}
      }
    },
    "executionPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "effective", "canGrant", "canRevoke"],
      "properties": {
        "requested": {"type": "boolean"},
        "effective": {"type": "boolean"},
        "canGrant": {"type": "boolean"},
        "canRevoke": {"type": "boolean"},
        "pendingActionExecutionId": {"type": "string", "format": "uuid"}
      }
    }
  }
}
