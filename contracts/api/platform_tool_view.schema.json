{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/platform_tool_view.schema.json",
  "title": "PlatformToolView",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resourceId",
    "resourceVersion",
    "ownerPrincipalId",
    "name",
    "source",
    "status",
    "resourceState",
    "actionKey",
    "inputSchemaHash",
    "outputSchemaHash",
    "canConsume"
  ],
  "properties": {
    "resourceId": {
      "type": "string",
      "format": "uuid"
    },
    "resourceVersion": {
      "type": "integer",
      "minimum": 1
    },
    "ownerPrincipalId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "description": "PLATFORM_NATIVE 为固定原生工具名（agent.memory.entry.list、agent.memory.entry.read、project_channel_request）；USER_REGISTERED_EXTERNAL 为 <连接器标识>__<上游工具名>（DD-149(3)）。"
    },
    "source": {
      "type": "string",
      "enum": [
        "PLATFORM_NATIVE",
        "USER_REGISTERED_EXTERNAL"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PROVISIONING",
        "ACTIVE"
      ]
    },
    "resourceState": {
      "$ref": "../enums/resource_state.schema.json"
    },
    "actionKey": {
      "type": "string",
      "description": "DD-140 (1)：平台原生工具名到动作键的封闭映射；记忆工具即其自身，project_channel_request 为 workspace.create。DD-149：连接器工具为其调用策略对应的子动作键。",
      "enum": [
        "agent.memory.entry.list",
        "agent.memory.entry.read",
        "workspace.create",
        "mcp_connection.tool.invoke",
        "mcp_connection.tool.invoke_confirmed",
        "mcp_connection.tool.invoke_approved"
      ]
    },
    "inputSchemaHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outputSchemaHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canConsume": {
      "type": "boolean"
    },
    "connector": {
      "title": "PlatformToolConnector",
      "type": "object",
      "additionalProperties": false,
      "description": "仅 USER_REGISTERED_EXTERNAL（DD-149）：所属连接器与冻结的工具元数据。描述是上游提供的不可信文本。",
      "required": [
        "connectionId",
        "connectionName",
        "connectionState",
        "upstreamName",
        "risk",
        "callPolicy",
        "visibility"
      ],
      "properties": {
        "connectionId": {
          "type": "string",
          "format": "uuid"
        },
        "connectionName": {
          "type": "string"
        },
        "connectionState": {
          "$ref": "../enums/mcp_connection_state.schema.json"
        },
        "upstreamName": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "risk": {
          "$ref": "../enums/mcp_tool_risk.schema.json"
        },
        "callPolicy": {
          "$ref": "../enums/mcp_tool_call_policy.schema.json"
        },
        "visibility": {
          "$ref": "../enums/mcp_connection_visibility.schema.json"
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
