{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/account_preferences.schema.json",
  "title": "AccountPreferences",
  "description": "GET /api/v1/account/preferences (DD-164(7)): the signed-in HumanIdentity's account preferences, shared by every Tenant and device. Absent fields have never been set; clients fall back to their defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "componentPreferences",
    "version"
  ],
  "properties": {
    "theme": {
      "type": "string",
      "description": "Theme name, 1-64 of [a-z0-9-]."
    },
    "accent": {
      "type": "string",
      "description": "neutral, kailo-brand or #rrggbb."
    },
    "followSystem": {
      "type": "boolean"
    },
    "locale": {
      "type": "string",
      "enum": [
        "en",
        "zh-CN"
      ],
      "description": "Kailo UI language (REQ-08)."
    },
    "componentPreferences": {
      "type": "array",
      "description": "DD-138 contributed preference values, at most 64, ordered by key.",
      "items": {
        "title": "AccountComponentPreference",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "07 §4.8.2 preference key."
          },
          "value": {
            "type": "string",
            "description": "BOOLEAN as true/false, ENUM as the option value (1-32 [A-Za-z0-9._-])."
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "description": "0 before the first write."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
