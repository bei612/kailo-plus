{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/gateway_call_page.schema.json",
  "title": "GatewayCallPage",
  "description": "DD-134(3)：时间窗内的调用列表，按开始时间倒序；nextCursor 只在同一查询条件内继续。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "calls",
    "truncated",
    "modelLogAvailable"
  ],
  "properties": {
    "scope": {
      "$ref": "../enums/gateway_admin_scope.schema.json"
    },
    "calls": {
      "type": "array",
      "items": {
        "$ref": "gateway_call_view.schema.json"
      }
    },
    "nextCursor": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    },
    "modelLogAvailable": {
      "type": "boolean"
    }
  }
}
