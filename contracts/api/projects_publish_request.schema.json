{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/projects_publish_request.schema.json",
  "title": "ProjectsPublishRequest",
  "description": "Typed original Community announcement mutation. Actor is the authenticated SERVER or CLIENT signer, never supplied by this request. Creation resolves the home Channel from an admitted Workspace; metadata is transient and remains Relay-owned. DELETE selects a real signed current announcement; it does not delete its channel or repositories.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation"],
  "properties": {
    "operation": {"title": "ProjectPublicationOperation", "type": "string", "enum": ["DELETE", "CREATE_PROJECT", "CREATE_REPOSITORY", "CREATE_ISSUE"]},
    "targetEventId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspaceId": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 2048},
    "visibility": {"title": "ProjectListingVisibility", "type": "string", "enum": ["listed", "unlisted"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 256, "description": "Original trimmed issue subject; the consumer additionally enforces the original JavaScript 256 UTF-16 code-unit limit."},
    "body": {"type": "string", "description": "Original markdown, empty allowed; current Relay NIP-11 and body admission limits are enforced before signing."},
    "category": {"title": "ProjectIssueCategory", "type": "string", "enum": ["issue", "change-request", "improvement"]}
  },
  "oneOf": [
    {"properties": {"operation": {"const": "DELETE"}}, "required": ["targetEventId"], "not": {"anyOf": [{"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["body"]}, {"required": ["category"]}]}},
    {"properties": {"operation": {"const": "CREATE_PROJECT"}}, "required": ["workspaceId", "name", "visibility"], "not": {"anyOf": [{"required": ["targetEventId"]}, {"required": ["title"]}, {"required": ["body"]}, {"required": ["category"]}]}},
    {"properties": {"operation": {"const": "CREATE_REPOSITORY"}}, "required": ["workspaceId", "name"], "not": {"anyOf": [{"required": ["targetEventId"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["body"]}, {"required": ["category"]}]}},
    {"properties": {"operation": {"const": "CREATE_ISSUE"}}, "required": ["targetEventId", "title", "body", "category"], "not": {"anyOf": [{"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}]}}
  ]
}
