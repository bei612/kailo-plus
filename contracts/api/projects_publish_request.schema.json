{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/projects_publish_request.schema.json",
  "title": "ProjectsPublishRequest",
  "description": "Typed original Community announcement mutation. Actor is the authenticated SERVER or CLIENT signer, never supplied by this request. Creation resolves the home Channel from an admitted Workspace; metadata is transient and remains Relay-owned. DELETE selects a real signed current announcement; it does not delete its channel or repositories. UPDATE_PULL_REQUEST publishes the original kind-1619 head update for the named immutable 1618 root, only as its author or repository owner; it carries commit and optional mergeBase, never a caller author, tags or clone URL. CREATE_PULL_REQUEST publishes the original NIP-34 1618 review for a branch already on the repository (DD-118); the push itself is not part of this request. APPROVE_PULL_REQUEST and the request-changes / inline-line variants of CREATE_PULL_REQUEST_COMMENT publish the original labeled kind-1 review comments (desktop pullRequestReviews.ts::submitProjectPullRequestReview, hooks.ts::createProjectPullRequestComment) against the named review head; they introduce no new Nostr kind (DD-118(5)). ATTACH_REPOSITORY (original useAttachProjectRepository / useAddProjectRepository) republishes the signer's current 30621 head named by targetEventId with one more member `a` coordinate; every other tag and the content are kept. BIND_REPOSITORY_CHANNEL (original useBindProjectRepositoryChannel) republishes the signer's current 30617 head with `buzz-channel` replaced by the admitted Workspace's Channel. ADD_PROJECT_CHANNEL (original useAddProjectChannel) appends that Channel as a `buzz-related-channel` tag to the signer's current 30621 head; the Channel itself is created by the existing workspace.create action, never by this request. None of them grants Git, Channel or project authority (REQ-24, DD-80, DD-118).",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation"],
  "properties": {
    "operation": {"title": "ProjectPublicationOperation", "type": "string", "enum": ["DELETE", "CREATE_PROJECT", "CREATE_REPOSITORY", "CREATE_ISSUE", "CREATE_ISSUE_COMMENT", "CREATE_PULL_REQUEST_COMMENT", "SELF_ASSIGN_ISSUE", "SELF_UNASSIGN_ISSUE", "ASSIGN_ISSUE", "UNASSIGN_ISSUE", "SET_PULL_REQUEST_STATUS", "CREATE_PULL_REQUEST", "UPDATE_PULL_REQUEST", "APPROVE_PULL_REQUEST", "ATTACH_REPOSITORY", "BIND_REPOSITORY_CHANNEL", "ADD_PROJECT_CHANNEL"]},
    "targetEventId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assigneeLabel": {"type": "string", "description": "Original transient display label, trimmed and limited to 128 Unicode characters by the consumer. Never an identity or authorization claim."},
    "assigneePubkey": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Other HUMAN recipient of an original issue-author/repository-owner assignment. Resolved against the admitted Tenant's existing HUMAN identity directory; never a signing identity. Self operations do not accept this field."},
    "priorEventId": {"type": "string", "description": "Optional immutable original per-self assignment operation head. Same publication intent retains it across UNKNOWN observation; never an authorization grant."},
    "workspaceId": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 2048},
    "visibility": {"title": "ProjectListingVisibility", "type": "string", "enum": ["listed", "unlisted"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 256, "description": "Original trimmed issue subject; the consumer additionally enforces the original JavaScript 256 UTF-16 code-unit limit."},
    "body": {"type": "string", "description": "Original complete markdown including attachment markdown. Issues may be empty; comments must be nonempty after trim. Current Relay NIP-11 and body admission limits are enforced before signing."},
    "mentions": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "attachments": {"type": "array", "items": {"$ref": "web_message_attachment.schema.json"}},
    "category": {"title": "ProjectIssueCategory", "type": "string", "enum": ["issue", "change-request", "improvement"]},
    "pullRequestStatus": {"title": "ProjectPullRequestLifecycleStatus", "type": "string", "enum": ["open", "draft", "closed"], "description": "Original pullRequestReviews.ts lifecycle states the UI may publish (NIP-34 1630/1633/1632). Merged (1631) happens through git and is never accepted here. Only the review author or repository owner signs it."},
    "branchName": {"type": "string", "minLength": 1, "maxLength": 255, "description": "Original 1618 `branch-name`: the compare branch, already present on the Relay repository."},
    "targetBranch": {"type": "string", "minLength": 1, "maxLength": 255, "description": "Original 1618 `target-branch`: the base branch."},
    "commit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$", "description": "Original `c`. UPDATE_PULL_REQUEST: the already-pushed head frozen by this update intent. CREATE_PULL_REQUEST: compare branch head read from the trusted repository state. APPROVE_PULL_REQUEST and CREATE_PULL_REQUEST_COMMENT with reviewDecision or an anchor: the review head the reviewer looked at; the consumer refuses with TARGET_STATE_CONFLICT unless it is still the review's current trusted head. Required by those review comments and refused on ordinary comments."},
    "mergeBase": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$", "description": "Original 1618/1619 `merge-base`, when known."},
    "reviewers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "description": "Original requested reviewers (p tags beside the repository owner). Never a signing identity or grant."},
    "reviewDecision": {"title": "ProjectPullRequestCommentDecision", "type": "string", "enum": ["request-changes"], "description": "Original hooks.ts ProjectPullRequestCommentDecision on CREATE_PULL_REQUEST_COMMENT only: adds the `changes-requested` label. Only a requested reviewer or the repository owner, never the review author, may request changes on an open or draft review; readers trust nothing else (projectPullRequests.mjs)."},
    "anchorPath": {"type": "string", "minLength": 1, "maxLength": 4096, "description": "Original inline diff anchor `file` (normalizeProjectPullRequestCommentAnchor): repository-relative, no leading slash, backslash, NUL, empty, `.` or `..` segment; at most 4096 UTF-16 code units. Only on CREATE_PULL_REQUEST_COMMENT, together with anchorSide, anchorLine and commit."},
    "anchorSide": {"title": "ProjectPullRequestCommentSide", "type": "string", "enum": ["old", "new"], "description": "Original inline diff anchor `side`."},
    "anchorLine": {"type": "integer", "minimum": 1, "maximum": 9007199254740991, "description": "Original inline diff anchor `line`: a 1-based line on the given side of the review diff."},
    "repositoryAddress": {"type": "string", "pattern": "^30617:[0-9a-f]{64}:.+$", "maxLength": 1100, "description": "ATTACH_REPOSITORY only: the original NIP-34 repository coordinate added as a member `a` tag. A coordinate, never a clone URL or an access grant; the repository head may not exist yet when it is the first step of the original add-repository sequence."},
    "cloneUrl": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048, "description": "CREATE_REPOSITORY only: the original optional `clone` tag of a new repository announcement (AddProjectRepositoryDialog Clone URL). Only metadata: Kailo reads repository content through the 30617 coordinate (DD-118) and never fetches this URL."}
  },
  "oneOf": [
    {"properties": {"operation": {"const": "DELETE"}}, "required": ["targetEventId"], "not": {"anyOf": [{"required": ["pullRequestStatus"]}, {"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["body"]}, {"required": ["category"]}, {"required": ["mentions"]}, {"required": ["attachments"]}, {"required": ["branchName"]}, {"required": ["targetBranch"]}, {"required": ["commit"]}, {"required": ["mergeBase"]}, {"required": ["reviewers"]}, {"required": ["reviewDecision"]}, {"required": ["anchorPath"]}, {"required": ["anchorSide"]}, {"required": ["anchorLine"]}, {"required": ["repositoryAddress"]}, {"required": ["cloneUrl"]}]}},
    {"properties": {"operation": {"const": "CREATE_PROJECT"}}, "required": ["workspaceId", "name", "visibility"], "not": {"anyOf": [{"required": ["pullRequestStatus"]}, {"required": ["targetEventId"]}, {"required": ["title"]}, {"required": ["body"]}, {"required": ["category"]}, {"required": ["mentions"]}, {"required": ["attachments"]}, {"required": ["branchName"]}, {"required": ["targetBranch"]}, {"required": ["commit"]}, {"required": ["mergeBase"]}, {"required": ["reviewers"]}, {"required": ["reviewDecision"]}, {"required": ["anchorPath"]}, {"required": ["anchorSide"]}, {"required": ["anchorLine"]}, {"required": ["repositoryAddress"]}, {"required": ["cloneUrl"]}]}},
    {"properties": {"operation": {"const": "CREATE_REPOSITORY"}}, "required": ["workspaceId", "name"], "not": {"anyOf": [{"required": ["pullRequestStatus"]}, {"required": ["targetEventId"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["body"]}, {"required": ["category"]}, {"required": ["mentions"]}, {"required": ["attachments"]}, {"required": ["branchName"]}, {"required": ["targetBranch"]}, {"required": ["commit"]}, {"required": ["mergeBase"]}, {"required": ["reviewers"]}, {"required": ["reviewDecision"]}, {"required": ["anchorPath"]}, {"required": ["anchorSide"]}, {"required": ["anchorLine"]}, {"required": ["repositoryAddress"]}]}},
    {"properties": {"operation": {"const": "CREATE_ISSUE"}}, "required": ["targetEventId", "title", "body", "category"], "not": {"anyOf": [{"required": ["pullRequestStatus"]}, {"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["mentions"]}, {"required": ["attachments"]}, {"required": ["branchName"]}, {"required": ["targetBranch"]}, {"required": ["commit"]}, {"required": ["mergeBase"]}, {"required": ["reviewers"]}, {"required": ["reviewDecision"]}, {"required": ["anchorPath"]}, {"required": ["anchorSide"]}, {"required": ["anchorLine"]}, {"required": ["repositoryAddress"]}, {"required": ["cloneUrl"]}]}},
    {"properties": {"operation": {"const": "CREATE_ISSUE_COMMENT"}}, "required": ["targetEventId", "body"], "not": {"anyOf": [{"required": ["pullRequestStatus"]}, {"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["category"]}, {"required": ["branchName"]}, {"required": ["targetBranch"]}, {"required": ["commit"]}, {"required": ["mergeBase"]}, {"required": ["reviewers"]}, {"required": ["reviewDecision"]}, {"required": ["anchorPath"]}, {"required": ["anchorSide"]}, {"required": ["anchorLine"]}, {"required": ["repositoryAddress"]}, {"required": ["cloneUrl"]}]}},
    {"properties": {"operation": {"const": "CREATE_PULL_REQUEST_COMMENT"}}, "required": ["targetEventId", "body"], "not": {"anyOf": [{"required": ["pullRequestStatus"]}, {"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["category"]}, {"required": ["branchName"]}, {"required": ["targetBranch"]}, {"required": ["mergeBase"]}, {"required": ["reviewers"]}, {"required": ["repositoryAddress"]}, {"required": ["cloneUrl"]}]}},
    {"properties": {"operation": {"enum": ["SELF_ASSIGN_ISSUE", "SELF_UNASSIGN_ISSUE"]}}, "required": ["targetEventId", "assigneeLabel"], "not": {"anyOf": [{"required": ["pullRequestStatus"]}, {"required": ["assigneePubkey"]}, {"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["category"]}, {"required": ["body"]}, {"required": ["mentions"]}, {"required": ["attachments"]}, {"required": ["branchName"]}, {"required": ["targetBranch"]}, {"required": ["commit"]}, {"required": ["mergeBase"]}, {"required": ["reviewers"]}, {"required": ["reviewDecision"]}, {"required": ["anchorPath"]}, {"required": ["anchorSide"]}, {"required": ["anchorLine"]}, {"required": ["repositoryAddress"]}, {"required": ["cloneUrl"]}]}},
    {"properties": {"operation": {"const": "SET_PULL_REQUEST_STATUS"}}, "required": ["targetEventId", "pullRequestStatus"], "not": {"anyOf": [{"required": ["assigneeLabel"]}, {"required": ["assigneePubkey"]}, {"required": ["priorEventId"]}, {"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["category"]}, {"required": ["body"]}, {"required": ["mentions"]}, {"required": ["attachments"]}, {"required": ["branchName"]}, {"required": ["targetBranch"]}, {"required": ["commit"]}, {"required": ["mergeBase"]}, {"required": ["reviewers"]}, {"required": ["reviewDecision"]}, {"required": ["anchorPath"]}, {"required": ["anchorSide"]}, {"required": ["anchorLine"]}, {"required": ["repositoryAddress"]}, {"required": ["cloneUrl"]}]}},
    {"properties": {"operation": {"enum": ["ASSIGN_ISSUE", "UNASSIGN_ISSUE"]}}, "required": ["targetEventId", "assigneeLabel", "assigneePubkey"], "not": {"anyOf": [{"required": ["pullRequestStatus"]}, {"required": ["priorEventId"]}, {"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["category"]}, {"required": ["body"]}, {"required": ["mentions"]}, {"required": ["attachments"]}, {"required": ["branchName"]}, {"required": ["targetBranch"]}, {"required": ["commit"]}, {"required": ["mergeBase"]}, {"required": ["reviewers"]}, {"required": ["reviewDecision"]}, {"required": ["anchorPath"]}, {"required": ["anchorSide"]}, {"required": ["anchorLine"]}, {"required": ["repositoryAddress"]}, {"required": ["cloneUrl"]}]}},
    {"properties": {"operation": {"const": "CREATE_PULL_REQUEST"}}, "required": ["targetEventId", "title", "body", "branchName", "targetBranch", "commit"], "not": {"anyOf": [{"required": ["pullRequestStatus"]}, {"required": ["assigneeLabel"]}, {"required": ["assigneePubkey"]}, {"required": ["priorEventId"]}, {"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["category"]}, {"required": ["attachments"]}, {"required": ["reviewDecision"]}, {"required": ["anchorPath"]}, {"required": ["anchorSide"]}, {"required": ["anchorLine"]}, {"required": ["repositoryAddress"]}, {"required": ["cloneUrl"]}]}},
    {"properties":{"operation":{"const":"UPDATE_PULL_REQUEST"}},"required":["targetEventId","commit"],"not":{"anyOf":[{"required":["pullRequestStatus"]},{"required":["assigneeLabel"]},{"required":["assigneePubkey"]},{"required":["priorEventId"]},{"required":["workspaceId"]},{"required":["name"]},{"required":["description"]},{"required":["visibility"]},{"required":["category"]},{"required":["attachments"]},{"required":["reviewDecision"]},{"required":["anchorPath"]},{"required":["anchorSide"]},{"required":["anchorLine"]},{"required":["repositoryAddress"]},{"required":["cloneUrl"]},{"required":["title"]},{"required":["body"]},{"required":["branchName"]},{"required":["targetBranch"]},{"required":["reviewers"]},{"required":["mentions"]}]}},
    {"properties": {"operation": {"const": "APPROVE_PULL_REQUEST"}}, "required": ["targetEventId", "commit"], "not": {"anyOf": [{"required": ["pullRequestStatus"]}, {"required": ["assigneeLabel"]}, {"required": ["assigneePubkey"]}, {"required": ["priorEventId"]}, {"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["category"]}, {"required": ["mentions"]}, {"required": ["attachments"]}, {"required": ["branchName"]}, {"required": ["targetBranch"]}, {"required": ["mergeBase"]}, {"required": ["reviewers"]}, {"required": ["reviewDecision"]}, {"required": ["anchorPath"]}, {"required": ["anchorSide"]}, {"required": ["anchorLine"]}, {"required": ["repositoryAddress"]}, {"required": ["cloneUrl"]}]}},
    {"properties": {"operation": {"const": "ATTACH_REPOSITORY"}}, "required": ["targetEventId", "repositoryAddress"], "not": {"anyOf": [{"required": ["pullRequestStatus"]}, {"required": ["assigneeLabel"]}, {"required": ["assigneePubkey"]}, {"required": ["priorEventId"]}, {"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["body"]}, {"required": ["category"]}, {"required": ["mentions"]}, {"required": ["attachments"]}, {"required": ["branchName"]}, {"required": ["targetBranch"]}, {"required": ["commit"]}, {"required": ["mergeBase"]}, {"required": ["reviewers"]}, {"required": ["reviewDecision"]}, {"required": ["anchorPath"]}, {"required": ["anchorSide"]}, {"required": ["anchorLine"]}, {"required": ["cloneUrl"]}]}},
    {"properties": {"operation": {"enum": ["BIND_REPOSITORY_CHANNEL", "ADD_PROJECT_CHANNEL"]}}, "required": ["targetEventId", "workspaceId"], "not": {"anyOf": [{"required": ["pullRequestStatus"]}, {"required": ["assigneeLabel"]}, {"required": ["assigneePubkey"]}, {"required": ["priorEventId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["body"]}, {"required": ["category"]}, {"required": ["mentions"]}, {"required": ["attachments"]}, {"required": ["branchName"]}, {"required": ["targetBranch"]}, {"required": ["commit"]}, {"required": ["mergeBase"]}, {"required": ["reviewers"]}, {"required": ["reviewDecision"]}, {"required": ["anchorPath"]}, {"required": ["anchorSide"]}, {"required": ["anchorLine"]}, {"required": ["repositoryAddress"]}, {"required": ["cloneUrl"]}]}}
  ]
}
