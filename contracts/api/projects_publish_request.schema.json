{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/projects_publish_request.schema.json",
  "title": "ProjectsPublishRequest",
  "description": "Typed original Community announcement mutation. Actor is the authenticated SERVER or CLIENT signer, never supplied by this request. Creation resolves the home Channel from an admitted Workspace; metadata is transient and remains Relay-owned. DELETE selects a real signed current announcement; it does not delete its channel or repositories.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation"],
  "properties": {
    "operation": {"title": "ProjectPublicationOperation", "type": "string", "enum": ["DELETE", "CREATE_PROJECT", "CREATE_REPOSITORY", "CREATE_ISSUE", "CREATE_ISSUE_COMMENT", "CREATE_PULL_REQUEST_COMMENT", "SELF_ASSIGN_ISSUE", "SELF_UNASSIGN_ISSUE", "ASSIGN_ISSUE", "UNASSIGN_ISSUE"]},
    "targetEventId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assigneeLabel": {"type": "string", "description": "Original transient display label, trimmed and limited to 128 Unicode characters by the consumer. Never an identity or authorization claim."},
    "assigneePubkey": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Other HUMAN recipient of an original issue-author/repository-owner assignment. Resolved against the admitted Tenant's existing HUMAN identity directory; never a signing identity. Self operations do not accept this field."},
    "priorEventId": {"type": "string", "description": "Optional immutable original per-self assignment operation head. Same publication intent retains it across UNKNOWN observation; never an authorization grant."},
    "workspaceId": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 2048},
    "visibility": {"title": "ProjectListingVisibility", "type": "string", "enum": ["listed", "unlisted"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 256, "description": "Original trimmed issue subject; the consumer additionally enforces the original JavaScript 256 UTF-16 code-unit limit."},
    "body": {"type": "string", "description": "Original complete markdown including attachment markdown. Issues may be empty; comments must be nonempty after trim. Current Relay NIP-11 and body admission limits are enforced before signing."},
    "mentions": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "attachments": {"type": "array", "items": {"$ref": "web_message_attachment.schema.json"}},
    "category": {"title": "ProjectIssueCategory", "type": "string", "enum": ["issue", "change-request", "improvement"]}
  },
  "oneOf": [
    {"properties": {"operation": {"const": "DELETE"}}, "required": ["targetEventId"], "not": {"anyOf": [{"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["body"]}, {"required": ["category"]}, {"required": ["mentions"]}, {"required": ["attachments"]}]}},
    {"properties": {"operation": {"const": "CREATE_PROJECT"}}, "required": ["workspaceId", "name", "visibility"], "not": {"anyOf": [{"required": ["targetEventId"]}, {"required": ["title"]}, {"required": ["body"]}, {"required": ["category"]}, {"required": ["mentions"]}, {"required": ["attachments"]}]}},
    {"properties": {"operation": {"const": "CREATE_REPOSITORY"}}, "required": ["workspaceId", "name"], "not": {"anyOf": [{"required": ["targetEventId"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["body"]}, {"required": ["category"]}, {"required": ["mentions"]}, {"required": ["attachments"]}]}},
    {"properties": {"operation": {"const": "CREATE_ISSUE"}}, "required": ["targetEventId", "title", "body", "category"], "not": {"anyOf": [{"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["mentions"]}, {"required": ["attachments"]}]}},
    {"properties": {"operation": {"const": "CREATE_ISSUE_COMMENT"}}, "required": ["targetEventId", "body"], "not": {"anyOf": [{"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["category"]}]}},
    {"properties": {"operation": {"const": "CREATE_PULL_REQUEST_COMMENT"}}, "required": ["targetEventId", "body"], "not": {"anyOf": [{"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["category"]}]}},
    {"properties": {"operation": {"enum": ["SELF_ASSIGN_ISSUE", "SELF_UNASSIGN_ISSUE"]}}, "required": ["targetEventId", "assigneeLabel"], "not": {"anyOf": [{"required": ["assigneePubkey"]}, {"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["category"]}, {"required": ["body"]}, {"required": ["mentions"]}, {"required": ["attachments"]}]}},
    {"properties": {"operation": {"enum": ["ASSIGN_ISSUE", "UNASSIGN_ISSUE"]}}, "required": ["targetEventId", "assigneeLabel", "assigneePubkey"], "not": {"anyOf": [{"required": ["priorEventId"]}, {"required": ["workspaceId"]}, {"required": ["name"]}, {"required": ["description"]}, {"required": ["visibility"]}, {"required": ["title"]}, {"required": ["category"]}, {"required": ["body"]}, {"required": ["mentions"]}, {"required": ["attachments"]}]}}
  ]
}
