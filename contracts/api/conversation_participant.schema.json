{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/conversation_participant.schema.json",
  "title": "ConversationParticipant",
  "description": "同租户当前有效 HUMAN 及其已投影真实身份公钥，不伪造用户资料。",
  "type": "object", "additionalProperties": false,
  "required": ["principalId", "displayName", "pubkeys"],
  "properties": {
    "principalId": {"type": "string", "format": "uuid"},
    "displayName": {"type": "string"},
    "pubkeys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
