{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/component_release_approval_report.schema.json",
  "title": "ComponentReleaseApprovalReport",
  "description": "原受信Worker在原审批后的COMPONENT_RELEASE Activity报告实际自身能力。Core自行读取自身与当前Web事实，并重新核验原release套件和审批。",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "runId", "workerBuild"],
  "properties": {
    "target": {"$ref": "../domain/component_release_approval_target.schema.json"},
    "runId": {"type": "string", "minLength": 1},
    "workerBuild": {"$ref": "../domain/platform_build_info.schema.json"}
  }
}
