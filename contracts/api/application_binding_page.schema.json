{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/application_binding_page.schema.json",
  "title": "ApplicationBindingPage",
  "description": "当前HUMAN管理scope内的真实接入元数据。不是组件内部状态、配置、SecretRef或原生管理credential。",
  "type": "object", "additionalProperties": false,
  "required": ["bindings", "canCreate"],
  "properties": {
    "canCreate": {"type": "boolean"},
    "nextOffset": {"type": "integer"},
    "bindableReleases": {"type": "array", "description": "仅 canCreate=true 时给出：Catalog 中已 APPROVED 的 APPLICATION release 的绑定所需公开声明（03 §9）。secretSchema 只含键与格式声明，供 Tenant admin 按项提交 bindingSecretValues；不含任何 secret 值、SecretRef、locator 或 Catalog 管理权。", "items": {
      "title": "ApplicationBindableRelease",
      "type": "object", "additionalProperties": false,
      "required": ["componentReleaseId", "componentTypeKey", "version", "secretSchema"],
      "properties": {
        "componentReleaseId": {"type": "string", "format": "uuid"},
        "componentTypeKey": {"type": "string"},
        "version": {"type": "string"},
        "secretSchema": {"type": "array", "items": {
          "title": "ApplicationBindableSecret",
          "type": "object", "additionalProperties": false,
          "required": ["secretKey", "valueType", "lengthOrFormat"],
          "properties": {
            "secretKey": {"type": "string"},
            "valueType": {"type": "string"},
            "lengthOrFormat": {"type": "string"}
          }
        }}
      }
    }},
    "bindings": {"type": "array", "items": {
      "title": "ApplicationBindingView",
      "type": "object", "additionalProperties": false,
      "required": ["bindingId", "tenantId", "componentReleaseId", "componentTypeKey", "state", "version", "capabilityCategories", "canDisable"],
      "properties": {
        "canDisable": {"type": "boolean"},
        "hasNativePage": {"type": "boolean", "description": "Approved release declares an independent native page. Launch still freshly checks binding, scope and deployment origins."},
        "nativePageCategory": {"$ref": "../enums/native_page_category.schema.json", "description": "DD-127(4): presentation category the approved NATIVE_PAGE release declares. The sidebar labels the entry by capabilityCategories ∪ this value; it grants nothing."},
        "hasReadReceiver": {"type": "boolean", "description": "Active approved binding declares a SERVICE read receiver. Resource discovery and writes still freshly check the original source share and receiver update permissions."},
        "bindingId": {"type": "string", "format": "uuid"},
        "tenantId": {"type": "string", "format": "uuid"},
        "workspaceId": {"type": "string", "format": "uuid"},
        "componentReleaseId": {"type": "string", "format": "uuid"},
        "componentTypeKey": {"type": "string"},
        "state": {"$ref": "../enums/application_binding_state.schema.json"},
        "version": {"type": "integer"},
        "activeProjectionGeneration": {"type": "integer"},
        "capabilityCategories": {"type": "array", "items": {
          "title": "ApplicationBindingCapability",
          "type": "object", "additionalProperties": false,
          "required": ["category", "version"],
          "properties": {"category": {"type": "string"}, "version": {"type": "integer"}}
        }}
      }
    }}
  }
}
