{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/web_presence_query_request.schema.json",
  "title": "WebPresenceQueryRequest",
  "description": "DD-120: presence for the requested pubkeys from the Relay-signed 20001 snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pubkeys"
  ],
  "properties": {
    "pubkeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
