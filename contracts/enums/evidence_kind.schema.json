{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enums/evidence_kind.schema.json",
  "title": "EvidenceKind",
  "description": "AuditEvent 中 EvidenceRef 的封闭种类（.design/03 §14）。每种只承载其权威源中的稳定 ID（可带 version），权威源、证据类型与敏感级别由种类唯一确定（Core 的固定描述表）。库中存量出现不在此列的种类时解释为不可用，不猜测含义。DD-135(8) 的 Skill 证据：`SKILL_SLUG` 为定义 slug；`SKILL_VERSION_ASSET_ID` 为版本 Asset ID，version 为版本序号；`SKILL_ARTIFACT_DIGEST` 为规范 artifact 的 SHA-256，version 为其字节数；`SKILL_UPLOAD_DIGEST` 为上传字节的 SHA-256。均不含 SKILL.md 正文。",
  "type": "string",
  "enum": [
    "TEMPORAL_WORKFLOW_ID",
    "TEMPORAL_RUN_ID",
    "TEMPORAL_FIRST_RUN_ID",
    "APPROVAL_WORKFLOW_ID",
    "APPROVAL_POLICY",
    "SPICEDB_ZEDTOKEN",
    "SPICEDB_RELATIONSHIP",
    "BUZZ_EVENT_ID",
    "BUZZ_PUBKEY",
    "PLATFORM_SESSION_ID",
    "ACTION_EXECUTION_ID",
    "ADMIT_ACTION_EXECUTION_ID",
    "ORIGINAL_ACTION_EXECUTION_ID",
    "TENANT_INVITATION_ID",
    "TENANT_MEMBERSHIP_ID",
    "SECRET_REF_REHOME_ID",
    "TENANT_LIFECYCLE_SNAPSHOT_ID",
    "TENANT_DELETE_SUBPROCESS_ID",
    "BUZZ_DELETION_REQUEST_ID",
    "BUZZ_DELETION_INVENTORY_DIGEST",
    "USAGE_EVENT_ID",
    "OPENMETER_EVENT_ID",
    "AGENTGATEWAY_USAGE_ID",
    "TRACE_ID",
    "EXTERNAL_SUBJECT_SHA256",
    "DEPLOYMENT_BOOTSTRAP",
    "SKILL_ARTIFACT_DIGEST",
    "SKILL_SLUG",
    "SKILL_VERSION_ASSET_ID",
    "SKILL_UPLOAD_DIGEST"
  ]
}
