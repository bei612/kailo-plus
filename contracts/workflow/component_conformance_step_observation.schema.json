{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow/component_conformance_step_observation.schema.json",
  "title": "ComponentConformanceStepObservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["caseKey", "stepKey", "operation", "requestDigest", "responseDigest", "httpStatus"],
  "properties": {
    "contentReference": {"$ref": "../domain/content_reference.schema.json"},
    "nativeScopeObservation": {"$ref": "../adapter/protocol.v1/scope_observation.schema.json"},
    "nativeReceiverObservation": {"$ref": "../domain/component_native_receiver_observation.schema.json"},
    "operation": {"$ref": "../enums/component_conformance_operation.schema.json"},
    "mcpResultKind": {"type":"string","enum":["RESULT","ERROR"]},
    "resultDigest": {"type": "string", "description": "实际返回的能力结果摘要；原结果正文不进入报告或 Core。"},
    "caseKey": {"type": "string"},
    "stepKey": {"type": "string"},
    "requestDigest": {"type": "string"},
    "responseDigest": {"type": "string"},
    "bindingDigest": {"type": "string", "description": "成功 validate_binding 的固定字段摘要，由 Core 从真实回执按 component_conformance_wire_digests 计算；其他操作不得携带。"},
    "httpStatus": {"type": "integer"},
    "errorClass": {"$ref": "../enums/error_class.schema.json"},
    "nativeObservation": {"$ref": "../adapter/protocol.v1/execution_observation.schema.json"}
  }
}
