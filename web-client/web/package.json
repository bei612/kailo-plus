  "scripts": {
    "postinstall": "patch -l -R -p1 --dry-run -d node_modules/virtua < ../../collaboration/patches/virtua@0.49.3.patch >/dev/null 2>&1 || (patch -l -p1 --dry-run -d node_modules/virtua < ../../collaboration/patches/virtua@0.49.3.patch && patch -l -p1 -d node_modules/virtua < ../../collaboration/patches/virtua@0.49.3.patch)",
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "check:file-sizes": "node ./scripts/check-file-sizes.mjs",
    "check:i18n": "node ./scripts/check-i18n.mjs",
    "check:pubkey-truncation": "node ./scripts/check-pubkey-truncation.mjs",
    "lint": "biome lint .",
    "check": "biome check . && npm run check:file-sizes && npm run check:i18n && npm run check:pubkey-truncation",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test": "vitest run src"
  },
