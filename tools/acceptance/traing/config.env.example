# Copy to state/config.env (0600), then: set -a; . state/config.env; set +a; ./run.sh <command>. Every value has a default.
KAILO_URL=https://192.168.0.149
# RUN_ID=20261122-0100            # reuse to re-run single steps into the same results/ and shots/ folders
# ACC_DOMAIN=tg-1122.kailo-acceptance.test   # fixed account domain (default tg-<timestamp>)
# ADMIN_ACCOUNT_FILE=/volumes/kailo/acceptance/traing/state/admin-account.json  # 0600 {"email","password"} of an existing platform admin; only needed when bootstrap is closed
# ASK_TIMEOUT_S=600
# KAILO_SRC=/volumes/kailo/kailo-macro     # the deployed checkout (smokes, verify scripts, compose)
# M0_DIR=/volumes/kailo/acceptance/m0      # trial-login.mjs and official.sh
# KAILO_DOCKER_HOST=unix:///run/kailo-docker/docker.sock
# KAILO_SECRETS=/volumes/kailo/deploy/kailo/secrets/secrets.env
# PW_IMAGE=mcr.microsoft.com/playwright:v1.62.0-noble
# PW_NODE_MODULES=/volumes/kailo/acceptance/m0/node_modules
