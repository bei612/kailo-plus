{
  "id": "{{releaseId}}",
  "componentTypeKey": "wren",
  "version": "1.7.0-native-page",
  "class": "APPLICATION",
  "platformPortKey": "NONE",
  "manifestSchemaVersion": 1,
  "admissionPath": "BUILTIN_REFERENCE",
  "sourceProject": "kailo-plus/data-query",
  "sourceCommit": "{{sourceCommit}}",
  "bindingConfigSchemaVersion": 1,
  "bindingConfigSchemaDigest": "{{bindingConfigSchemaDigest}}",
  "adapterProtocolRange": "NONE",
  "frontendDelivery": {
    "mode": "NATIVE_PAGE",
    "extensionSlots": [],
    "editorOrigins": [],
    "nativePageOrigins": [
      "{{nativePageOrigin}}"
    ],
    "nativePageCategory": "data_query"
  },
  "executionConnector": {
    "mode": "NONE",
    "adapterProtocolRange": "NONE",
    "actionTokenAudience": "NONE"
  },
  "adapterBuildRef": "{{adapterBuildRef}}",
  "implements": [],
  "capabilityDeclarations": [],
  "allowedModelCallModes": [
    "NONE",
    "PLATFORM_LLM_ROUTE"
  ],
  "dataStoreIsolation": "DEDICATED_INSTANCE",
  "dataLocation": "Platform-operated dedicated Wren GenBI instance (UI, AI service, engine, Ibis) with its own metadata database on the deployment's private component network; queried datasources stay at their declared location.",
  "secretSchema": [],
  "targetResourceTypeKeys": [],
  "resourceTypeDefinitions": [],
  "actionDefinitions": [],
  "toolDefinitions": [],
  "businessObservabilityContract": {
    "correlationSources": [
      "OPERATION_ID"
    ],
    "businessStateSources": [
      "CORE_ACTION"
    ],
    "aggregationDimensions": [
      "tenant_id",
      "workspace_id"
    ],
    "redactionPolicy": "PLATFORM_METADATA_ONLY"
  },
  "frontendPresentationContract": {
    "integrationMode": "KAILO_EMBED",
    "themeMapping": { "LIGHT": "light", "DARK": "dark" },
    "localeMapping": { "ZH_CN": "zh-CN", "EN": "en" },
    "themeChangePolicy": "LIVE",
    "localeResolutionPolicy": "BROWSER_RESOLVED",
    "preferences": [
      {
        "key": "appearance.listDensity",
        "settingsCategory": "APPEARANCE",
        "valueType": "ENUM",
        "options": [
          { "value": "comfortable", "label": { "ZH_CN": "舒适", "EN": "Comfortable" } },
          { "value": "compact", "label": { "ZH_CN": "紧凑", "EN": "Compact" } }
        ],
        "defaultValue": "comfortable",
        "label": { "ZH_CN": "列表密度", "EN": "List density" },
        "description": { "ZH_CN": "列表与表格的行高", "EN": "Row height of lists and tables" }
      }
    ],
    "adminSurfaces": [
      {
        "key": "dataSources.connection",
        "adminCategory": "DATA_SOURCES",
        "path": "/kailo-admin/data-source",
        "requiredPermission": "BINDING_MANAGE",
        "access": "EDITABLE",
        "title": { "ZH_CN": "数据源连接", "EN": "Data source connection" },
        "description": {
          "ZH_CN": "连接用于问答的数据库，选择要建模的数据表并定义表之间的关系。",
          "EN": "Connect the database used for asking questions, choose the tables to model and define their relationships."
        }
      },
      {
        "key": "semantic.modeling",
        "adminCategory": "DATA_SOURCES",
        "path": "/kailo-admin/modeling",
        "requiredPermission": "BINDING_MANAGE",
        "access": "EDITABLE",
        "title": { "ZH_CN": "语义建模", "EN": "Semantic modeling" },
        "description": {
          "ZH_CN": "维护模型、视图、计算字段与关系，并发布模型供问答使用。",
          "EN": "Maintain models, views, calculated fields and relationships, and deploy the models for asking."
        }
      },
      {
        "key": "system.project",
        "adminCategory": "SYSTEM",
        "path": "/kailo-admin/project",
        "requiredPermission": "BINDING_MANAGE",
        "access": "EDITABLE",
        "title": { "ZH_CN": "项目设置", "EN": "Project settings" },
        "description": {
          "ZH_CN": "设置回答语言，或重置项目。",
          "EN": "Set the answer language, or reset the project."
        }
      }
    ]
  }
}
