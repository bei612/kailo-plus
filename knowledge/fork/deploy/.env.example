# Configuration references only. Do not put credential values in this file.
# There is deliberately no latest tag or generated password fallback.
# Set each repository and digest from the corresponding Kailo source-built
# artifact record; a repository contains no tag or digest. No official image
# is substituted when a source-built artifact is absent.
KNOWLEDGE_APP_REPOSITORY=
KNOWLEDGE_APP_DIGEST=
KNOWLEDGE_UI_REPOSITORY=
KNOWLEDGE_UI_DIGEST=
KNOWLEDGE_DOCREADER_REPOSITORY=
KNOWLEDGE_DOCREADER_DIGEST=

KNOWLEDGE_UI_PORT=
KNOWLEDGE_DB_USER=
KNOWLEDGE_DB_NAME=
KNOWLEDGE_NATIVE_ORIGIN=
KNOWLEDGE_OIDC_ISSUER_URL=
KNOWLEDGE_OIDC_DISCOVERY_URL=
KNOWLEDGE_OIDC_CLIENT_ID=

# Absolute paths to private OpenBao Agent template outputs (no trailing newline
# in single-line values). SYSTEM_AES_KEY is exactly 32 UTF-8 bytes, not 64 hex.
KNOWLEDGE_DB_PASSWORD_FILE=
KNOWLEDGE_REDIS_PASSWORD_FILE=
KNOWLEDGE_REDIS_CONFIG_FILE=
KNOWLEDGE_SYSTEM_AES_KEY_FILE=
KNOWLEDGE_SYSTEM_SIGNING_KEY_FILE=
KNOWLEDGE_JWT_SECRET_FILE=
KNOWLEDGE_OIDC_CLIENT_SECRET_FILE=

# redis_config is a native Redis file rendered by the same secret authority:
# appendonly yes
# dir /data
# requirepass "<properly escaped value from the same redis_password SecretRef>"
# No literal credentials, new secret authority, or Redis CLI password argument.
