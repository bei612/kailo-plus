# Configuration references only. Do not put credential values in this file.
# There is deliberately no latest tag or generated password fallback.
# Set each repository and digest from the corresponding Kailo source-built
# artifact record; a repository contains no tag or digest. No official image
# is substituted when a source-built artifact is absent.
KNOWLEDGE_APP_REPOSITORY=
KNOWLEDGE_APP_DIGEST=
KNOWLEDGE_UI_REPOSITORY=
KNOWLEDGE_UI_DIGEST=
KNOWLEDGE_DOCREADER_REPOSITORY=
KNOWLEDGE_DOCREADER_DIGEST=

KNOWLEDGE_UI_BIND_ADDRESS=
KNOWLEDGE_UI_PORT=
# Select exact private subnets after checking Docker IPAM and host/VPN/cluster
# routes. No global Docker pool changes or platform-data-network attachment.
KNOWLEDGE_UI_SUBNET=
KNOWLEDGE_DATA_SUBNET=
KNOWLEDGE_DB_USER=
KNOWLEDGE_DB_NAME=
KNOWLEDGE_NATIVE_ORIGIN=
# Exact Kailo Web/Desktop parent origins, separated by spaces. Empty keeps
# native same-origin framing. This never grants a native account or permission.
KAILO_FRAME_ANCESTORS=
KNOWLEDGE_OIDC_ISSUER_URL=
KNOWLEDGE_OIDC_DISCOVERY_URL=
KNOWLEDGE_OIDC_CLIENT_ID=
# Native SSRF allowlist additions, comma-separated exact approved hosts/IPs.
# A private/IP-literal IdP needs its actual host here; do not allow whole subnets.
# This native setting covers all outbound clients, not only OIDC.
KNOWLEDGE_SSRF_WHITELIST_EXTRA=
# Optional Gateway model transport: run bash start.sh --platform-model with the
# absolute platform deploy/local/.env path. Do not copy its URL/network here.
# Only app joins its existing edge; LLM/admin are not published on the host.
# The existing entrypoint adds only that URL's exact hostname to the native
# SSRF list. This grants transport reachability, not a model/key/binding/grant.

# The native client and native service keys are provisioned by provision.py.
# These are deployment references, not component bindings or end-user grants.
# Supply an existing IdP operator credential and OpenBao bootstrap credential
# via private files. They are never mounted into a native service.
KNOWLEDGE_IDP_ADMIN_URL=
KNOWLEDGE_IDP_REALM=
KNOWLEDGE_IDP_ADMIN_USER=
KNOWLEDGE_IDP_ADMIN_PASSWORD_FILE=
KNOWLEDGE_BAO_URL=
KNOWLEDGE_BAO_BOOTSTRAP_FILE=
KNOWLEDGE_BAO_NAMESPACE=
KNOWLEDGE_BAO_KV_MOUNT=
KNOWLEDGE_BAO_SECRET_PATH=
KNOWLEDGE_BAO_ROLE=
KNOWLEDGE_BAO_TOKEN_TTL=
KNOWLEDGE_BAO_WRAP_TTL=
KNOWLEDGE_PROVISION_TIMEOUT_SECONDS=
KNOWLEDGE_DELIVERY_DIRECTORY=

# Optional existing-model handoff. Original operator entrypoints:
# provision.py model-reader -> existing OpenBao Agent -> provision.py model-delivery
# INPUT contains the frozen Core generation projection plus existing native model
# IDs and exact base URLs; it is metadata, not a model-creation request.
# SESSION is a private file holding a short-lived native Admin login token, never
# a platform identity or permanent native Owner API key. No values in argv/logs.
KNOWLEDGE_MODEL_DELIVERY_INPUT_FILE=
KNOWLEDGE_MODEL_CREDENTIAL_FILE=
KNOWLEDGE_NATIVE_ADMIN_SESSION_FILE=

# Absolute paths to private OpenBao Agent template outputs (no trailing newline
# in single-line values). SYSTEM_AES_KEY is exactly 32 UTF-8 bytes, not 64 hex.
KNOWLEDGE_DB_PASSWORD_FILE=
KNOWLEDGE_REDIS_PASSWORD_FILE=
KNOWLEDGE_REDIS_CONFIG_FILE=
KNOWLEDGE_SYSTEM_AES_KEY_FILE=
KNOWLEDGE_SYSTEM_SIGNING_KEY_FILE=
KNOWLEDGE_JWT_SECRET_FILE=
KNOWLEDGE_OIDC_CLIENT_SECRET_FILE=

# Optional governed adapter: provision.py adapter-reader consumes this exact
# existing adapter configuration; start.sh --platform-adapter consumes its
# source-built image and the generated dedicated Agent config. No binding is
# created or activated by either command. Never duplicate secret values here.
# After adapter-reader and the original Agent deliver the fixed secret, run
# provision.py adapter-client with the platform's existing OIDC_SERVICE_CLIENT_ID,
# OIDC_WORKER_CLIENT_ID, OIDC_BROWSER_CLIENT_ID and OIDC_NATIVE_CLIENT_ID in the
# process environment, together with its resolved OIDC_ISSUER. These are the
# original deploy/local/.env identity facts,
# not new Knowledge settings. The confidential service client uses adapter
# oidcClientId/token URL/secret file; its audience is Core's service audience,
# never actionTokenAudience or a native login/AI audience. Existing differences
# are refused, not overwritten. This registers no platform grant or binding.
KNOWLEDGE_ADAPTER_REPOSITORY=
KNOWLEDGE_ADAPTER_DIGEST=
KNOWLEDGE_ADAPTER_AGENT_REPOSITORY=
KNOWLEDGE_ADAPTER_AGENT_DIGEST=
KNOWLEDGE_ADAPTER_CONFIG_FILE=
KNOWLEDGE_ADAPTER_JWKS_FILE=
KNOWLEDGE_ADAPTER_BOOTSTRAP_DIRECTORY=
KNOWLEDGE_ADAPTER_DELIVERY_DIRECTORY=
KNOWLEDGE_ADAPTER_BAO_ROLE=
# Existing network on which Core's service listener, IdP and Bao are reachable;
# not a data network. Only adapter and its Agent join it, not the native DB/UI.
KNOWLEDGE_ADAPTER_PLATFORM_NETWORK=
# Kailo DD-133(4) member directory read (07 §4.7.4). Empty = not delivered:
# every Kailo login stays a contributor and nobody is a native administrator.
# The five keys are named together (start.sh then adds
# compose.member-directory.yaml; app joins KNOWLEDGE_ADAPTER_PLATFORM_NETWORK
# to reach Core's service listener). BINDING_ID is the native page entry
# binding; CLIENT_ID is this instance's own directory client, equal to the
# binding's directoryClientId (component-bind.mjs --directory-client-id);
# CLIENT_SECRET_FILE is the 0600 file the platform release writes
# (bootstrap.sh --declare-directory-clients), owned by the app user (uid 1000);
# TOKEN_URL is <issuer>/protocol/openid-connect/token; CORE_URL is
# http://<BFF_SERVICE_NAME>:<SERVICE_CONTAINER_PORT> of the platform .env.
KNOWLEDGE_DIRECTORY_BINDING_ID=
KNOWLEDGE_DIRECTORY_CLIENT_ID=
KNOWLEDGE_DIRECTORY_CLIENT_SECRET_FILE=
KNOWLEDGE_DIRECTORY_TOKEN_URL=
KNOWLEDGE_DIRECTORY_CORE_URL=
# Poll interval in seconds (10-3600, default 60); only with the group above.
KNOWLEDGE_DIRECTORY_INTERVAL_SECONDS=
# Both dedicated containers use the owner of their existing private directories.
# Provision as that non-root owner; don't relax directory/file permissions.
KNOWLEDGE_ADAPTER_UID=
KNOWLEDGE_ADAPTER_GID=
KNOWLEDGE_ADAPTER_CPUS=
KNOWLEDGE_ADAPTER_MEMORY=
KNOWLEDGE_ADAPTER_AGENT_CPUS=
KNOWLEDGE_ADAPTER_AGENT_MEMORY=

# Optional native FILE_STORAGE receiver (start.sh --file-storage-sync). Supply
# the complete original native config including file_storage_sync and its own
# binding-specific service credential rendered by the existing OpenBao Agent.
# The secret path must equal file_storage_sync.oidc_client_secret_file; neither
# value is inferred from native login or model Gateway credentials.
KNOWLEDGE_FILE_STORAGE_SYNC_CONFIG_FILE=
KNOWLEDGE_FILE_STORAGE_SYNC_OIDC_SECRET_FILE=

# redis_config is a native Redis file rendered by the same secret authority:
# appendonly yes
# dir /data
# requirepass "<properly escaped value from the same redis_password SecretRef>"
# No literal credentials, new secret authority, or Redis CLI password argument.
