{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BindingConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nativePageUrl",
    "modelGateway",
    "client_id"
  ],
  "properties": {
    "nativePageUrl": {
      "type": "string",
      "minLength": 1,
      "description": "Exact native page entry URL; its origin must be one of the release nativePageOrigins and the deployment NATIVE_PAGE_ORIGINS."
    },
    "modelGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeResourceIds",
        "meterKeys"
      ],
      "properties": {
        "routeResourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "meterKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "This binding's own adapter IdP client id. Core's adapter PEP, read-grant and native task callbacks identify the binding only by it (unique among non-DISABLED bindings); the adapter authenticates with it and the Agent-delivered oidc_client_secret."
    }
  }
}
