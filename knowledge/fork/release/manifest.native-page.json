{
  "id": "{{releaseId}}",
  "componentTypeKey": "weknora",
  "version": "1.7.0-native-page",
  "class": "APPLICATION",
  "platformPortKey": "NONE",
  "manifestSchemaVersion": 1,
  "admissionPath": "BUILTIN_REFERENCE",
  "sourceProject": "kailo-plus/knowledge",
  "sourceCommit": "{{sourceCommit}}",
  "bindingConfigSchemaVersion": 1,
  "bindingConfigSchemaDigest": "{{bindingConfigSchemaDigest}}",
  "adapterProtocolRange": "NONE",
  "frontendDelivery": {
    "mode": "NATIVE_PAGE",
    "extensionSlots": [],
    "editorOrigins": [],
    "nativePageOrigins": [
      "{{nativePageOrigin}}"
    ],
    "nativePageCategory": "knowledge"
  },
  "executionConnector": {
    "mode": "NONE",
    "adapterProtocolRange": "NONE",
    "actionTokenAudience": "NONE"
  },
  "adapterBuildRef": "{{adapterBuildRef}}",
  "implements": [],
  "capabilityDeclarations": [],
  "allowedModelCallModes": [
    "NONE",
    "PLATFORM_LLM_ROUTE"
  ],
  "dataStoreIsolation": "DEDICATED_INSTANCE",
  "dataLocation": "Platform-operated dedicated WeKnora instance with its own database, vector store and object storage on the deployment's private component network.",
  "secretSchema": [],
  "targetResourceTypeKeys": [],
  "resourceTypeDefinitions": [],
  "actionDefinitions": [],
  "toolDefinitions": [],
  "businessObservabilityContract": {
    "correlationSources": [
      "OPERATION_ID"
    ],
    "businessStateSources": [
      "CORE_ACTION"
    ],
    "aggregationDimensions": [
      "tenant_id",
      "workspace_id"
    ],
    "redactionPolicy": "PLATFORM_METADATA_ONLY"
  },
  "frontendPresentationContract": {
    "integrationMode": "KAILO_EMBED",
    "themeMapping": {
      "LIGHT": "light",
      "DARK": "dark"
    },
    "localeMapping": {
      "ZH_CN": "zh-CN",
      "EN": "en-US"
    },
    "themeChangePolicy": "LIVE",
    "localeResolutionPolicy": "BROWSER_RESOLVED",
    "adminSurfaces": [
      {
        "key": "models.catalog",
        "adminCategory": "MODELS",
        "path": "/platform/admin/models",
        "requiredPermission": "TENANT_MANAGE",
        "access": "READ_ONLY",
        "title": {
          "ZH_CN": "模型目录",
          "EN": "Model catalog"
        },
        "description": {
          "ZH_CN": "知识库与 Agent 可选用的模型，由平台模型路由提供。",
          "EN": "Models that knowledge bases and agents can use, provided by platform model routing."
        }
      },
      {
        "key": "storage.backends",
        "adminCategory": "STORAGE",
        "path": "/platform/admin/storage",
        "requiredPermission": "TENANT_MANAGE",
        "access": "READ_ONLY",
        "title": {
          "ZH_CN": "存储与向量库",
          "EN": "Storage and vector stores"
        },
        "description": {
          "ZH_CN": "文件存储与向量库由部署声明，在此只读查看。",
          "EN": "File storage and vector stores are set by the deployment and shown here read-only."
        }
      },
      {
        "key": "indexing.parsers",
        "adminCategory": "INDEXING",
        "path": "/platform/admin/parsers",
        "requiredPermission": "TENANT_MANAGE",
        "access": "READ_ONLY",
        "title": {
          "ZH_CN": "文档解析引擎",
          "EN": "Document parsers"
        },
        "description": {
          "ZH_CN": "解析文档所用的引擎与可处理的文件类型，由部署声明。",
          "EN": "Engines that parse documents and the file types they handle, set by the deployment."
        }
      },
      {
        "key": "answers.skills",
        "adminCategory": "INTEGRATIONS",
        "path": "/platform/admin/skills",
        "requiredPermission": "TENANT_MANAGE",
        "access": "EDITABLE",
        "title": {
          "ZH_CN": "问答技能",
          "EN": "Answer skills"
        },
        "description": {
          "ZH_CN": "登记 Agent 在问答中可调用的技能。",
          "EN": "Register the skills agents can use when answering."
        }
      },
      {
        "key": "answers.mcpServices",
        "adminCategory": "INTEGRATIONS",
        "path": "/platform/admin/mcp-services",
        "requiredPermission": "TENANT_MANAGE",
        "access": "EDITABLE",
        "title": {
          "ZH_CN": "MCP 服务",
          "EN": "MCP services"
        },
        "description": {
          "ZH_CN": "连接问答可调用的 MCP 工具服务。",
          "EN": "Connect MCP tool services that answers can call."
        }
      },
      {
        "key": "answers.webSearch",
        "adminCategory": "INTEGRATIONS",
        "path": "/platform/admin/web-search",
        "requiredPermission": "TENANT_MANAGE",
        "access": "EDITABLE",
        "title": {
          "ZH_CN": "联网搜索",
          "EN": "Web search"
        },
        "description": {
          "ZH_CN": "配置问答使用的联网搜索服务。",
          "EN": "Set up the web search services answers use."
        }
      }
    ]
  }
}
