{
  "realm": "kailo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "kailo-core",
      "name": "Platform Core/BFF 与 Application Worker 的服务身份",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "access.token.lifespan": "900"
      },
      "protocolMappers": [
        {
          "name": "temporal-permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "permissions",
            "claim.value": "[\"__TEMPORAL_NAMESPACE__:worker\",\"__TEMPORAL_NAMESPACE__:write\",\"__TEMPORAL_NAMESPACE__:read\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "secret": "__KAILO_CORE_CLIENT_SECRET__"
    },
    {
      "clientId": "buzz-web",
      "name": "Browser 登录客户端；密钥由 AgentGateway 持有，浏览器不持有",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "__OIDC_REDIRECT_URI__"
      ],
      "webOrigins": [
        "+"
      ],
      "secret": "__BROWSER_CLIENT_SECRET__"
    }
  ],
  "users": [
    {
      "username": "__VERIFY_USER__",
      "enabled": true,
      "emailVerified": true,
      "email": "verify@kailo.local",
      "firstName": "Seam",
      "lastName": "Verifier",
      "credentials": [
        {
          "type": "password",
          "value": "__VERIFY_USER_PASSWORD__",
          "temporary": false
        }
      ]
    }
  ]
}
