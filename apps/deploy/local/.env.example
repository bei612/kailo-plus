# 本地开发拓扑的必填变量。compose.yaml 对每一项都用 ${VAR:?} 强制，
# 缺任一项即拒绝启动——这是「杜绝硬编码」的执行点，不是提示。
# 复制为 deploy/local/.env 后填写；.env 不进版本库。
CORE_DB_NAME=
CORE_DB_USER=
CORE_DB_PORT=
# 部署展示名只填一次；Web 的 HTML、PWA 与标题从这里投影。
PLATFORM_DISPLAY_NAME=
# 本地公开入口主机名与网关端口；同一主值投影到 Compose 别名和浏览器 origin。
PUBLIC_HOST=
AGENTGATEWAY_PORT=
PUBLIC_ORIGIN=http://${PUBLIC_HOST}:${AGENTGATEWAY_PORT}
TEMPORAL_DB_NAME=
TEMPORAL_DB_USER=
TEMPORAL_FRONTEND_PORT=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_PORT=
TEMPORAL_NAMESPACE=
TEMPORAL_RETENTION=
OIDC_REALM=
OIDC_SERVICE_CLIENT_ID=
OIDC_HOST=
# 本地 Keycloak issuer 由主机名、端口和 realm 派生，不单独维护 URL。
OIDC_ISSUER=http://${OIDC_HOST}:${KEYCLOAK_PORT}/realms/${OIDC_REALM}
OIDC_BROWSER_CLIENT_ID=
BFF_BIND_ADDR=
BFF_CONTAINER_PORT=
BFF_PORT=
BFF_SERVICE_NAME=
WEB_SERVICE_NAME=
WEB_CONTAINER_PORT=
VERIFY_USER=
BOOTSTRAP_USER=
# Platform Catalog Tenant 的首位 admin（DD-96 的 Tenant 暂停/恢复发起者）。
# 与 VERIFY_USER、BOOTSTRAP_USER 两两不同（IdP 用户名不区分大小写）。
PLATFORM_ADMIN_USER=
VERIFY_TENANT_SLUG=
VERIFY_TENANT_NAME=
VERIFY_BOOTSTRAP_WAIT_SECONDS=
REGISTRY_PORT=
REGISTRY_HOST=
PLATFORM_SESSION_TTL_SECONDS=
BFF_MESSAGE_PAGE_LIMIT=
BFF_STREAM_BUFFER=
BFF_STREAM_AUTH_TIMEOUT_SECONDS=
BFF_STREAM_READMIT_SECONDS=
BFF_STREAM_RETRY_MILLIS=
BFF_MEDIA_MAX_BYTES=
