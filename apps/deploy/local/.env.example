# 本地开发拓扑的必填变量。compose.yaml 对每一项都用 ${VAR:?} 强制，
# 缺任一项即拒绝启动——这是「杜绝硬编码」的执行点，不是提示。
# 复制为 deploy/local/.env 后填写；.env 不进版本库。
CORE_DB_NAME=
CORE_DB_USER=
CORE_DB_PORT=
TEMPORAL_DB_NAME=
TEMPORAL_DB_USER=
TEMPORAL_FRONTEND_PORT=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_PORT=
OIDC_JWKS_URI=
TEMPORAL_NAMESPACE=
TEMPORAL_RETENTION=
OIDC_REALM=
OIDC_SERVICE_CLIENT_ID=
