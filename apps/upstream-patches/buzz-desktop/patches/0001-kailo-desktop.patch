+/**
+ * Right-click a freshly posted video once the timeline is at rest. The new row
+ * renders first and the timeline then re-pins to the bottom; a right-click
+ * during that settle either lands beside the player (it is hit-tested at the
+ * moment of the click) or opens the menu just before the re-pin's scroll
+ * dismisses it — the menu closes on any scroll, as it should. A reader
+ * right-clicks a player that has stopped moving.
+ */
+async function rightClickPlayer(player: import("@playwright/test").Locator) {
+  const page = player.page();
+  await expect(page.locator("[data-render-pending]")).toHaveCount(0);
+  let previous = "";
+  await expect
+    .poll(async () => {
+      const current = await player.evaluate((el) => {
+        const scroller = el.closest<HTMLElement>(
+          '[data-buzz-conversation-scroll="true"]',
+        );
+        const rect = el.getBoundingClientRect();
+        return JSON.stringify([
+          scroller?.scrollTop,
+          scroller?.scrollHeight,
+          rect.top,
+          rect.left,
+        ]);
+      });
+      const atRest = current === previous;
+      previous = current;
+      return atRest;
+    })
+    .toBe(true);
+  // `force` skips the actionability guard: the Play-button overlay sits above
+  // the video, but the contextmenu event still capture-bubbles to the surface
+  // handler that opens the menu.
+  await player.click({ button: "right", force: true });
+}
