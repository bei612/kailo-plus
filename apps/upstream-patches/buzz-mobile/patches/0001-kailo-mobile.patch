+import 'package:flutter/material.dart';
+import 'package:hooks_riverpod/hooks_riverpod.dart';
+
+import '../../shared/contracts/contracts.dart';
+import '../../shared/kailo/kailo_views.dart';
+import '../../shared/widgets/app_list.dart';
+import '../../shared/widgets/app_list_card.dart';
+import 'kailo_async_view.dart';
+
+/// 本人的审计记录（`.design/03` §14：未经目标 audit 权限判定时只看自己的动作）。
+class KailoAuditPage extends ConsumerWidget {
+  const KailoAuditPage({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    return Scaffold(
+      appBar: AppBar(title: const Text('My activity log')),
+      body: KailoAsyncView(
+        value: ref.watch(kailoOwnAuditProvider),
+        onRetry: () => ref.invalidate(kailoOwnAuditProvider),
+        builder: (context, entries) => entries.isEmpty
+            ? const Center(child: Text('No recorded actions yet.'))
+            : ListView(
+                children: [
+                  AppListCard(
+                    children: [
+                      for (final (index, entry) in entries.indexed)
+                        AppListRow(
+                          key: ValueKey('kailo-audit-$index'),
+                          title: entry.actionKey,
+                          subtitle: _auditSubtitle(entry),
+                          subtitleMaxLines: 3,
+                        ),
+                    ],
+                  ),
+                ],
+              ),
+      ),
+    );
+  }
+}
+
+String _auditSubtitle(OwnAuditEntry entry) {
+  final type = auditEventTypeValues.reverse[entry.eventType]!;
+  final when = DateTime.tryParse(entry.occurredAt)?.toLocal();
+  final at = when == null ? entry.occurredAt : when.toString();
+  return '$type · ${entry.decision} · ${entry.resultCode}\n$at';
+}
