+
+String _memberSubtitle(WorkspaceMemberView member) {
+  final state = workspaceMembershipStateValues.reverse[member.state]!;
+  final keys = member.pubkeys.length;
+  return '$state · $keys ${keys == 1 ? 'key' : 'keys'}';
+}
diff --git a/mobile/lib/features/kailo/kailo_sign_in_page.dart b/mobile/lib/features/kailo/kailo_sign_in_page.dart
new file mode 100644
