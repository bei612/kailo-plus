+        );
+    }
+
+    #[tokio::test]
+    async fn governed_relay_without_engine_refuses_workflow_commands() {
+        let state = state(true, false).await;
+        assert!(matches!(
+            workflow_engine(&state),
+            Err(IngestError::Rejected(m)) if m == WORKFLOWS_DISABLED
