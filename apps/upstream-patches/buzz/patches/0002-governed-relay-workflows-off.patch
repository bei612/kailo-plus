+/// Kinds that define, trigger, approve or deny a relay workflow.
+const WORKFLOW_COMMAND_KINDS: [u32; 4] = [
+    KIND_WORKFLOW_DEF,
+    KIND_WORKFLOW_TRIGGER,
+    KIND_APPROVAL_GRANT,
+    KIND_APPROVAL_DENY,
