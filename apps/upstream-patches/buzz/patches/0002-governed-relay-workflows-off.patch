+        assert_eq!(
+            status(&router, Method::POST, "/workflows/self-check/runs").await,
+            StatusCode::METHOD_NOT_ALLOWED
+        );
+        assert!(verify_workflows_disabled(&state, &router).await.is_ok());
+    }
+
+    #[tokio::test]
