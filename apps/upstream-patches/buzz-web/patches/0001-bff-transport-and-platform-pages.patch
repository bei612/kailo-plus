-import { useRepoRefs } from "./use-repo-refs";
-import { useRepo } from "./use-repos";
-
-export interface RepoContext {
-  owner: string;
-  repoName: string;
-  defaultRef: string;
-  isLoading: boolean;
-  error: Error | null;
-}
-
-export function useRepoContext(
-  repoId: string,
-  { relayUrl, preview = false }: { relayUrl: string; preview?: boolean },
