-  const targets: Array<{ el: Element; attr: string }> = [
-    ...[...doc.querySelectorAll("script[src]")].map((el) => ({
-      el,
-      attr: "src",
-    })),
-    ...[...doc.querySelectorAll("link[href]")].map((el) => ({
-      el,
-      attr: "href",
-    })),
-    ...[...doc.querySelectorAll("img[src]")].map((el) => ({ el, attr: "src" })),
