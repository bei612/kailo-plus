-  await Promise.all(
-    targets.map(async ({ el, attr }) => {
-      const ref = el.getAttribute(attr);
-      if (!ref || isExternalRef(ref)) return;
-      const path = resolveRelative(baseDir, ref);
-      if (!path) return;
-      const mime = ASSET_MIME[extOf(path)] ?? "application/octet-stream";
