-export const AUXILIARY_KINDS = [5, 7, 9005, 40003];
-
-const SYSTEM_MESSAGE_TYPES = [
-  "member_joined",
-  "member_left",
-  "member_removed",
-  "topic_changed",
-  "purpose_changed",
-  "channel_created",
-  "channel_archived",
