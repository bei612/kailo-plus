-
-  const sender = senderPubkey.toLowerCase();
-  return [...new Set(candidates.map((pubkey) => pubkey.toLowerCase()))].filter(
-    (pubkey) => /^[0-9a-f]{64}$/.test(pubkey) && pubkey !== sender,
