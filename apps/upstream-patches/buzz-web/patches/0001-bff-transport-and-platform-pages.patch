-export async function ensureClone(
-  relayUrl: string,
-  owner: string,
-  repoName: string,
-  ref: string,
-): Promise<{ fs: LightningFS; dir: string }> {
-  const fs = getFs(relayUrl, owner, repoName);
-  const dir = getDir(owner, repoName);
-  const url = repoGitUrl(relayUrl, owner, repoName);
-  const headers = await authHeaders(relayUrl, owner, repoName);
-
-  let exists = false;
-  try {
-    await fs.promises.stat(`${dir}/.git`);
-    exists = true;
-  } catch {
-    // repo not cloned yet
-  }
-
-  if (exists) {
-    try {
-      await fetch({
-        fs,
-        http,
-        dir,
-        url,
-        ref,
-        depth: 1,
-        singleBranch: true,
-        headers,
-      });
-    } catch {
-      // fetch may fail if ref hasn't changed — that's fine
-    }
-  } else {
-    await clone({
-      fs,
-      http,
-      dir,
-      url,
-      ref,
-      depth: 1,
-      singleBranch: true,
-      noTags: true,
-      headers,
-    });
-  }
