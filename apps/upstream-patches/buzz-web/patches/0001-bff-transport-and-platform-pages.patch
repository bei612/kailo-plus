-    const blob = new Blob([bytes as Uint8Array<ArrayBuffer>], {
-      type: contentType,
-    });
-    const next = URL.createObjectURL(blob);
-    setUrl(next);
-    return () => {
-      URL.revokeObjectURL(next);
-    };
-  }, [bytes, contentType]);
-  return url;
-}
