-    data: repo,
-    isLoading: repoLoading,
-    error: repoError,
-  } = useRepo(repoId, {
-    relayUrl,
-    preview,
-  });
-  const { data: refs, isLoading: refsLoading } = useRepoRefs(repoId, {
-    relayUrl,
-    preview,
-  });
-
-  return {
-    owner: repo?.owner ?? "",
-    repoName: repo?.id ?? "",
-    defaultRef: refs?.head?.ref ?? "main",
