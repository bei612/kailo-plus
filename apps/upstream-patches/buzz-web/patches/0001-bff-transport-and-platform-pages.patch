-export async function readBlobView(
-  fs: LightningFS,
-  dir: string,
-  oid: string,
-  filepath: string,
-): Promise<BlobView> {
-  const { blob } = await readBlob({ fs, dir, oid, filepath });
-  const bytes = blob as Uint8Array;
-  const sizeBytes = bytes.length;
-  const ext = extOf(filepath);
-
-  const mime = RASTER_IMAGE_MIME[ext];
