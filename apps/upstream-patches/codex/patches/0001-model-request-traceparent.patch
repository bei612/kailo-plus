+
+#[test]
+fn test_api_provider_propagates_host_trace_context() {
+    use opentelemetry::trace::TracerProvider as _;
+    use tracing_subscriber::prelude::*;
+
+    let tracer_provider = opentelemetry_sdk::trace::SdkTracerProvider::builder().build();
+    let subscriber = tracing_subscriber::registry().with(
+        tracing_opentelemetry::layer().with_tracer(tracer_provider.tracer("model-provider-test")),
+    );
+    let _guard = subscriber.set_default();
+    tracing::callsite::rebuild_interest_cache();
+
+    let host_trace_id = "4bf92f3577b34da6a3ce929d0e0e4736";
+    let host_traceparent = format!("00-{host_trace_id}-00f067aa0ba902b7-01");
+    let span = tracing::info_span!("model_request");
+    assert!(codex_otel::set_parent_from_w3c_trace_context(
+        &span,
+        &codex_protocol::protocol::W3cTraceContext {
+            traceparent: Some(host_traceparent.clone()),
+            tracestate: None,
+        },
+    ));
+    let _entered = span.enter();
+
+    let info = ModelProviderInfo {
+        http_headers: Some(maplit::hashmap! {
+            "x-provider-header".to_string() => "preserved".into(),
+        }),
+        ..ModelProviderInfo::create_openai_provider(/*base_url*/ None)
+    };
+    let headers = info
+        .to_api_provider(/*auth_mode*/ None)
+        .expect("provider should resolve")
+        .headers;
+
+    let traceparent = headers
+        .get("traceparent")
+        .expect("model request should carry traceparent")
+        .to_str()
+        .expect("traceparent should be ASCII");
+    let parts: Vec<&str> = traceparent.split('-').collect();
+    assert_eq!(parts.len(), 4);
+    assert_eq!(parts[0], "00");
+    assert_eq!(parts[1], host_trace_id);
+    assert_ne!(traceparent, host_traceparent);
+    assert_eq!(
+        headers.get("x-provider-header"),
+        Some(&HeaderValue::from_static("preserved"))
+    );
+}
