{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canary.schema.json",
  "title": "Canary",
  "description": "可用 JSON Schema 子集的可执行定义。它穷举 contracts/README.md 第 1 节允许的每一种构造；四侧生成器必须全部生成成功并通过双向序列化。新增构造先加进本文件并四侧验证通过，才允许在其他 schema 中使用。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "count", "ratio", "enabled", "tags", "errorClass", "nested"],
  "properties": {
    "id": { "type": "string", "format": "uuid", "description": "format: uuid" },
    "occurredAt": { "type": "string", "format": "date-time", "description": "format: date-time，且为可选字段" },
    "name": { "type": "string", "description": "基础 string" },
    "count": { "type": "integer", "description": "基础 integer" },
    "ratio": { "type": "number", "description": "基础 number" },
    "enabled": { "type": "boolean", "description": "基础 boolean" },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "同构数组" },
    "errorClass": { "$ref": "enums/error_class.schema.json", "description": "跨文件 $ref 引用封闭枚举" },
    "capabilityState": { "$ref": "enums/capability_state.schema.json", "description": "可选的枚举引用" },
    "nested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "description": "内联对象，同样显式关闭 additionalProperties",
      "properties": {
        "label": { "type": "string" },
        "weights": { "type": "array", "items": { "type": "number" } }
      }
    },
    "variants": {
      "type": "array",
      "description": "变体类型的平坦表达：封闭枚举 tag 加各变体字段全部可选，替代被禁用的 oneOf",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "enum": ["FILE", "MESSAGE", "TASK"] },
          "fileDigest": { "type": "string" },
          "messageBody": { "type": "string" },
          "taskAttempt": { "type": "integer" }
        }
      }
    }
  }
}
